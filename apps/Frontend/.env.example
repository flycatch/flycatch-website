# Visitor-facing gateway origin (canonical URLs, Open Graph).
PUBLIC_ORIGIN=http://localhost:8080
PUBLIC_ENVIRONMENT=development
# Optional server-side API base. In Compose/k8s set to http://backend:8000.
# API_ORIGIN=http://localhost:8080
# Google reCAPTCHA v2 site key. The value below is Google's published test key
# (localhost only). Replace it with the site key for this domain in production.
# Pair it with RECAPTCHA_SECRET_KEY on the backend.
PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
