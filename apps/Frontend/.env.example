# Visitor-facing gateway origin (canonical URLs, Open Graph).
PUBLIC_ORIGIN=http://localhost:8080
PUBLIC_ENVIRONMENT=development
# Production reCAPTCHA v2 site key. Leave empty in local/dev to skip the widget.
# PUBLIC_RECAPTCHA_SITE_KEY=6LdGw5kqAAAAAHDPmQSzayLL4cTdXUL_-9Lw_dIt
# Optional server-side API base. In Compose/k8s set to http://backend:8000.
# Image rebuilds on publish should pass the public gateway origin so getStaticPaths
# can read live CMS records.
# API_ORIGIN=http://localhost:8080
