{
  "name": "@flycatch/frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host",
    "build": "node scripts/ensure-published-snapshot.mjs && astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "check": "node scripts/ensure-published-snapshot.mjs && astro check",
    "generate:types": "node scripts/generate-types.mjs",
    "check:contracts": "node scripts/check-contract-drift.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "check:parity": "node scripts/check-build-parity.mjs",
    "check:all": "npm run check:contracts && npm run check:seo && npm run check:i18n && npm run check:sitemap",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.3.0",
    "astro": "^5.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-plugin-astro": "^1.3.1",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "yaml": "^2.7.0"
  }
}
