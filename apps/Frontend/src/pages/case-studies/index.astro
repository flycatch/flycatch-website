---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeCaseStudies from '../../components/HomeCaseStudies.astro';
import { loadPublishedCaseStudies } from '../../lib/public-api';
import { fallbackMetadata, publicSiteSettings } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const listed = await loadPublishedCaseStudies();
const siteSettings = publicSiteSettings();
const metadata = fallbackMetadata(
  '/case-studies',
  t('nav.case_studies'),
  listed.error ? t('home.error') : t('home.empty'),
);
metadata.title = `${t('nav.case_studies')} — ${siteSettings.site_name}`;
metadata.indexable = !listed.error;
---
<BaseLayout title={metadata.title} metadata={metadata}>
  <SiteHeader />
  <main id="main" class="page-main" data-api-origin={listed.origin}>
    <div class="container summary-region">
      <h1>{t('nav.case_studies')}</h1>
    </div>
    <HomeCaseStudies studies={listed.items} error={listed.error} />
  </main>
  <SiteFooter />
</BaseLayout>
