---
export const prerender = true;

import InteriorLayout from '../../layouts/InteriorLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SectionState from '../../components/SectionState.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import { imageAlt } from '../../lib/image';
import {
  loadPublishedCaseStudy,
  publicMediaUrl,
} from '../../lib/public-api';
import {
  fallbackMetadata,
  metadataFromCaseStudy,
  publicSiteSettings,
} from '../../lib/metadata';
import { caseStudyStructuredData } from '../../lib/json-ld';
import { t } from '../../lib/i18n';
import { caseStudyStaticPaths } from '../../lib/static-paths';

export function getStaticPaths() {
  return caseStudyStaticPaths();
}

const { slug } = Astro.params;
if (!slug) throw new Error('Case study slug missing');

const siteSettings = publicSiteSettings();
const result = await loadPublishedCaseStudy(slug);
const study = result.item;
if (!study) {
  Astro.response.status = 404;
}
const metadata = study
  ? metadataFromCaseStudy(study, siteSettings, `/case-studies/${study.slug}`)
  : fallbackMetadata(
      `/case-studies/${slug}`,
      t('nav.case_studies'),
      result.error ? t('home.error') : t('home.empty'),
    );
const structuredData = study ? caseStudyStructuredData(study, metadata, siteSettings) : [];
const image = study ? publicMediaUrl(study.image_key) : null;
const chips = study ? [...study.industries, ...study.categories] : [];
const heading = study ? study.heading : t('nav.case_studies');
---
<InteriorLayout title={metadata.title} metadata={metadata} structuredData={structuredData} breadcrumbLabel={heading}>
  <SiteHeader breadcrumbLabel={heading} />
  <main id="main" class="page-main" data-api-origin={result.origin}>
    <article class="container">
      <SectionState error={result.error} empty={!result.error && !study} />
      <h1>{heading}</h1>{study && (
        <div>
          <p class="insight-meta" hidden={!study.date}>{study.date}</p>
          <p class="lede">{study.description}</p>
          <div class="media-frame" hidden={!image}>{image && (
            <OptimizedImage src={image} alt={imageAlt(study.image_alt, study.heading)} width={1192} height={640} sizes="(max-width: 768px) 100vw, 1192px" priority />
          )}</div>
          <div class="chip-row">{chips.map((item) => (
            <span class="chip">{item.name}</span>
          ))}</div>
          <div class="body-region" set:html={study.body} />
        </div>
      )}
    </article>
  </main>
  <SiteFooter />
</InteriorLayout>
