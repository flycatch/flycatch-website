---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home.css';
import '../../styles/ai-services.css';
import '../../styles/services.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeInsights from '../../components/HomeInsights.astro';
import HomeCta from '../../components/HomeCta.astro';
import AiServicesMinds from '../../components/AiServicesMinds.astro';
import ServicesHero from '../../components/ServicesHero.astro';
import ServicesOffering from '../../components/ServicesOffering.astro';
import ServicesMotto from '../../components/ServicesMotto.astro';
import ServicesCore from '../../components/ServicesCore.astro';
import {
  loadPublishedBlogs,
  loadPublishedOverview,
  loadPublishedOverviews,
} from '../../lib/public-api';
import { fallbackMetadata, metadataFromContentSeo, publicSiteSettings } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const reservedAboutSlugs = new Set(['about', 'company-overview']);
const [listed, blogsResult] = await Promise.all([
  loadPublishedOverviews(),
  loadPublishedBlogs(),
]);
const slug =
  listed.items.find((item) => item.slug === 'services')?.slug ??
  listed.items.find((item) => !reservedAboutSlugs.has(item.slug))?.slug ??
  '';
const detail = slug
  ? await loadPublishedOverview(slug)
  : { item: null, error: listed.error, origin: listed.origin };
const page = detail.item;
const failed = detail.error || (listed.error && !page);
const siteSettings = publicSiteSettings();
const metadata = page
  ? metadataFromContentSeo(page.seo, siteSettings, t('page.services.title'))
  : fallbackMetadata(
      '/services',
      t('page.services.title'),
      failed ? t('home.error') : t('home.empty'),
    );
---
<BaseLayout title={metadata.title} metadata={metadata}>
  <SiteHeader tone="dark" />
  <main id="main" class="services-page" data-api-origin={detail.origin}>
    <ServicesHero page={page} failed={failed} />
    <ServicesOffering page={page} />
    <ServicesMotto />
    <ServicesCore />
    <AiServicesMinds />
    <HomeInsights blogs={blogsResult.items} error={blogsResult.error} home />
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
