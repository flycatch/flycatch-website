---
export const prerender = true;

import InteriorLayout from '../../layouts/InteriorLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LandingPage from '../../components/LandingPage.astro';
import { loadPublishedLanding } from '../../lib/public-api';
import { PRODUCTION_SERVICE_SLUGS } from '../../lib/page-catalog';
import {
  buildCanonicalUrl,
  fallbackMetadata,
  metadataFallbackForPath,
  metadataFromContentSeo,
  publicSiteSettings,
} from '../../lib/metadata';
import { t } from '../../lib/i18n';

const listed = await loadPublishedLanding('/api/v1/public/overview', 'services');
const page = listed.item;
const siteSettings = publicSiteSettings();
const path = '/services';
const metadata = page
  ? {
      ...metadataFromContentSeo(page.seo, siteSettings, metadataFallbackForPath(path)),
      canonical: buildCanonicalUrl(siteSettings.canonical_origin, path),
    }
  : fallbackMetadata(
      path,
      t('page.services.title'),
      listed.error ? t('home.error') : t('page.services.description'),
    );
metadata.indexable = !listed.error;
const heading = page?.seo.h1_tag.trim() || page?.banner_title || t('page.services.title');
const serviceLinks = PRODUCTION_SERVICE_SLUGS.map((slug) => ({
  href: `/services/${slug}`,
  label: t(`page.services.slug.${slug}`),
}));
---
<InteriorLayout title={metadata.title} metadata={metadata}>
  <SiteHeader tone={page ? 'dark' : 'light'} showBreadcrumbs={false} />
  <main id="main" class="page-main page-main-flush" data-api-origin={listed.origin}>
    <LandingPage page={page} error={listed.error} heading={heading} />
    <nav class="container" aria-label={t('page.services.list_label')}>
      <h2>{t('page.services.list_heading')}</h2>
      <ul>
        {serviceLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </main>
  <SiteFooter />
</InteriorLayout>
