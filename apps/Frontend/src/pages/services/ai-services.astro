---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home.css';
import '../../styles/ai-services.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeInsights from '../../components/HomeInsights.astro';
import HomeCta from '../../components/HomeCta.astro';
import SectionState from '../../components/SectionState.astro';
import AiServicesHero from '../../components/AiServicesHero.astro';
import AiServicesIntro from '../../components/AiServicesIntro.astro';
import AiServicesSolutions from '../../components/AiServicesSolutions.astro';
import AiServicesExpertise from '../../components/AiServicesExpertise.astro';
import AiServicesIndustries from '../../components/AiServicesIndustries.astro';
import AiServicesMinds from '../../components/AiServicesMinds.astro';
import {
  loadPublishedAiService,
  loadPublishedAiServices,
  loadPublishedBlogs,
} from '../../lib/public-api';
import {
  buildCanonicalUrl,
  fallbackMetadata,
  metadataFallbackForPath,
  metadataFromContentSeo,
  publicSiteSettings,
} from '../../lib/metadata';
import { t } from '../../lib/i18n';

const [primary, blogsResult] = await Promise.all([
  loadPublishedAiService('ai-services'),
  loadPublishedBlogs({ maxItems: 3 }),
]);
let resolved = primary;
if (!primary.item) {
  const listed = await loadPublishedAiServices();
  const slug = listed.items.find((item) => item.slug === 'ai-services')?.slug ?? listed.items[0]?.slug;
  if (slug && slug !== 'ai-services') {
    resolved = await loadPublishedAiService(slug);
  }
}
const page = resolved.item;
const failed = resolved.error && !page;
const siteSettings = publicSiteSettings();
const aiServicesPath = '/services/ai-services';
const metadata = page
  ? {
      ...metadataFromContentSeo(page.seo, siteSettings, metadataFallbackForPath(aiServicesPath)),
      canonical: buildCanonicalUrl(siteSettings.canonical_origin, aiServicesPath),
    }
  : fallbackMetadata(
      aiServicesPath,
      t('page.ai_services.title'),
      failed ? t('home.error') : t('page.ai_services.description'),
    );
---
<BaseLayout title={metadata.title} metadata={metadata} breadcrumbLabel={t('page.ai_services.title')}>
  <SiteHeader tone="dark" breadcrumbLabel={t('page.ai_services.title')} />
  <main id="main" class="ai-services-page" data-api-origin={resolved.origin}>{page ? (
      <AiServicesHero page={page} />
    ) : (
      <section class="ai-hero">
        <div class="container ai-hero-copy summary-region">
          <h1 id="ai-heading" class="type-display-lg">{t('page.ai_services.title')}</h1>
          <SectionState error={failed} empty={!failed} />
        </div>
      </section>
    )}
    {page && <AiServicesIntro page={page} />}
    {page && <AiServicesSolutions page={page} />}
    {page && <AiServicesExpertise page={page} />}
    {page && <AiServicesIndustries page={page} />}
    <HomeInsights blogs={blogsResult.items} error={blogsResult.error} home />
    <AiServicesMinds />
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
