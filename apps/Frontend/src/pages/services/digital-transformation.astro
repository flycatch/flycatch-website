---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home.css';
import '../../styles/ai-services.css';
import '../../styles/application-development.css';
import '../../styles/digital-transformation.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeInsights from '../../components/HomeInsights.astro';
import HomeCta from '../../components/HomeCta.astro';
import AdsOfferings from '../../components/AdsOfferings.astro';
import DigitalTransformationHero from '../../components/DigitalTransformationHero.astro';
import DigitalTransformationIntro from '../../components/DigitalTransformationIntro.astro';
import DigitalTransformationGuidelines from '../../components/DigitalTransformationGuidelines.astro';
import DigitalTransformationStories from '../../components/DigitalTransformationStories.astro';
import {
  digitalTransformationAsOfferingsLanding,
  loadPublishedBlogs,
  loadPublishedDigitalTransformation,
  loadPublishedDigitalTransformations,
} from '../../lib/public-api';
import { fallbackMetadata, metadataFromContentSeo, publicSiteSettings } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const preferred = 'digital-transformation';
const [listed, blogsResult] = await Promise.all([
  loadPublishedDigitalTransformations(),
  loadPublishedBlogs(),
]);
const slug =
  listed.items.find((item) => item.slug === preferred)?.slug ??
  listed.items[0]?.slug ??
  preferred;
const detail = await loadPublishedDigitalTransformation(slug);
const page = detail.item;
const landing = page ? digitalTransformationAsOfferingsLanding(page) : null;
const failed = detail.error || (listed.error && !page);
const siteSettings = publicSiteSettings();
const metadata = page
  ? metadataFromContentSeo(page.seo, siteSettings, t('page.digital_transformation.title'))
  : fallbackMetadata(
      '/services/digital-transformation',
      t('page.digital_transformation.title'),
      failed ? t('home.error') : t('home.empty'),
    );
---
<BaseLayout title={metadata.title} metadata={metadata}>
  <SiteHeader tone="dark" />
  <main id="main" class="digital-transformation-page" data-api-origin={detail.origin}>
    <DigitalTransformationHero page={page} failed={failed} />
    {page && <DigitalTransformationIntro page={page} />}
    <DigitalTransformationGuidelines />
    <DigitalTransformationStories />
    {landing && <AdsOfferings page={landing} />}
    <HomeInsights blogs={blogsResult.items} error={blogsResult.error} home />
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
