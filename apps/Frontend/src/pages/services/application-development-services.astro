---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home.css';
import '../../styles/ai-services.css';
import '../../styles/application-development.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeInsights from '../../components/HomeInsights.astro';
import HomeCta from '../../components/HomeCta.astro';
import HomeFaq from '../../components/HomeFaq.astro';
import AdsHero from '../../components/AdsHero.astro';
import AdsIntro from '../../components/AdsIntro.astro';
import AdsOfferings from '../../components/AdsOfferings.astro';
import AdsContactPoster from '../../components/AdsContactPoster.astro';
import AdsRelatedCaseStudies from '../../components/AdsRelatedCaseStudies.astro';
import AiServicesMinds from '../../components/AiServicesMinds.astro';
import {
  loadPublishedApplicationDevelopment,
  loadPublishedApplicationDevelopments,
  loadPublishedBlogs,
  loadPublishedCaseStudies,
  loadPublishedCaseStudy,
  type PublicCaseStudy,
} from '../../lib/public-api';
import { fallbackMetadata, metadataFromContentSeo, publicSiteSettings } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const [listed, blogsResult, casesResult] = await Promise.all([
  loadPublishedApplicationDevelopments(),
  loadPublishedBlogs(),
  loadPublishedCaseStudies(),
]);
const slug =
  listed.items.find((item) => item.slug === 'application-development-services')?.slug ??
  listed.items[0]?.slug ??
  'application-development-services';
const detail = await loadPublishedApplicationDevelopment(slug);
const page = detail.item;
const failed = detail.error || (listed.error && !page);
const siteSettings = publicSiteSettings();
const metadata = page
  ? metadataFromContentSeo(page.seo, siteSettings, t('page.application_development.title'))
  : fallbackMetadata(
      '/services/application-development-services',
      t('page.application_development.title'),
      failed ? t('home.error') : t('home.empty'),
    );
const faqs = (page?.faq_accordion ?? []).map((item) => ({
  title: item.title,
  contents: item.contents,
}));
const relatedSlugs = [...casesResult.items]
  .sort((a, b) => {
    const dateA = a.date ? Date.parse(a.date) : Number.NaN;
    const dateB = b.date ? Date.parse(b.date) : Number.NaN;
    const hasA = Number.isFinite(dateA);
    const hasB = Number.isFinite(dateB);
    if (hasA && hasB && dateB !== dateA) return dateB - dateA;
    if (hasA !== hasB) return hasA ? -1 : 1;
    return b.order - a.order;
  })
  .slice(0, 3)
  .map((item) => item.slug)
  .filter(Boolean);
const relatedDetails = await Promise.all(relatedSlugs.map((itemSlug) => loadPublishedCaseStudy(itemSlug)));
const relatedStudies: PublicCaseStudy[] = relatedDetails
  .map((result) => result.item)
  .filter((item): item is PublicCaseStudy => Boolean(item));
const relatedError = casesResult.error || relatedDetails.some((result) => result.error);
---
<BaseLayout title={metadata.title} metadata={metadata}>
  <SiteHeader tone="dark" />
  <main id="main" class="application-development-page" data-api-origin={detail.origin}>
    <AdsHero page={page} failed={failed} />
    {page && <AdsIntro page={page} />}
    <AdsContactPoster
      eyebrow={t('page.application_development.contact_eyebrow')}
      title={t('page.application_development.contact_title')}
      description={t('page.application_development.contact_description')}
      action={t('page.application_development.contact_action')}
      href="/contact-us"
      image="/application-development/development-contact.webp"
      imageAlt={t('page.application_development.contact_image_alt')}
      imageWidth={500}
      imageHeight={550}
    />
    {page && <AdsOfferings page={page} />}
    <AiServicesMinds />
    <AdsRelatedCaseStudies studies={relatedStudies} error={relatedError} />
    <AdsContactPoster
      eyebrow={t('page.application_development.scale_eyebrow')}
      title={t('page.application_development.scale_title')}
      action={t('page.application_development.scale_action')}
      href="/contact-us"
      image="/application-development/scale-business.webp"
      imageAlt={t('page.application_development.scale_image_alt')}
      imageWidth={624}
      imageHeight={573}
    />
    {page && (
      <HomeFaq
        title={page.faq_title}
        description={page.faq_description}
        faqs={faqs}
        error={detail.error}
      />
    )}
    <HomeInsights blogs={blogsResult.items} error={blogsResult.error} home />
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
