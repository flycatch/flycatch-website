---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home.css';
import '../../styles/solutions.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeInsights from '../../components/HomeInsights.astro';
import HomeCta from '../../components/HomeCta.astro';
import SectionState from '../../components/SectionState.astro';
import SolutionsHero from '../../components/SolutionsHero.astro';
import SolutionsProducts from '../../components/SolutionsProducts.astro';
import SolutionsMotto from '../../components/SolutionsMotto.astro';
import {
  loadPublishedBlogs,
  loadPublishedSolutionProducts,
  loadPublishedSolutions,
} from '../../lib/public-api';
import { fallbackMetadata, metadataFromContentSeo, publicSiteSettings } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const [listed, productsResult, blogsResult] = await Promise.all([
  loadPublishedSolutions(),
  loadPublishedSolutionProducts(),
  loadPublishedBlogs(),
]);
const page = listed.items[0] ?? null;
const failed = listed.error && !page;
const siteSettings = publicSiteSettings();
const metadata = page
  ? metadataFromContentSeo(page.seo, siteSettings, t('page.solutions.title'))
  : fallbackMetadata(
      '/solutions',
      t('page.solutions.title'),
      failed ? t('home.error') : t('home.empty'),
    );
---
<BaseLayout title={metadata.title} metadata={metadata}>
  <SiteHeader tone="dark" />
  <main id="main" class="solutions-page" data-api-origin={listed.origin}>{page ? (
      <SolutionsHero page={page} />
    ) : (
      <section class="solutions-hero">
        <div class="container solutions-hero-copy summary-region">
          <h1 id="solutions-heading" class="type-display-lg">{t('page.solutions.title')}</h1>
          <SectionState error={failed} empty={!failed} />
        </div>
      </section>
    )}
    <SolutionsProducts
      title={page?.section_title ?? ''}
      products={productsResult.items}
      error={productsResult.error}
    />
    <SolutionsMotto />
    <HomeInsights blogs={blogsResult.items} error={blogsResult.error} home />
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
