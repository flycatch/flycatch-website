---
import SolutionDetailPage from '../../components/SolutionDetailPage.astro';
import { resolveSolutionDetailRoute } from '../../lib/solution-detail';

const product = resolveSolutionDetailRoute(Astro.params.slug);
if (!product) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
---
<SolutionDetailPage product={product} />
