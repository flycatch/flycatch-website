---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home.css';
import '../../styles/solutions.css';
import '../../styles/doctcare.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeInsights from '../../components/HomeInsights.astro';
import HomeCta from '../../components/HomeCta.astro';
import SectionState from '../../components/SectionState.astro';
import DoctcareHero from '../../components/DoctcareHero.astro';
import DoctcareIntro from '../../components/DoctcareIntro.astro';
import DoctcareChallenges from '../../components/DoctcareChallenges.astro';
import DoctcareBenefits from '../../components/DoctcareBenefits.astro';
import DoctcareCta from '../../components/DoctcareCta.astro';
import { loadPublishedBlogs, loadPublishedSolutionDetail } from '../../lib/public-api';
import { fallbackMetadata, metadataFromContentSeo, publicSiteSettings } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const slug = 'doctcare-ai';
const [detail, blogsResult] = await Promise.all([
  loadPublishedSolutionDetail(slug),
  loadPublishedBlogs(),
]);
const page = detail.item;
const failed = detail.error && !page;
const siteSettings = publicSiteSettings();
const metadata = page
  ? metadataFromContentSeo(
      {
        ...page.seo,
        canonical_url: page.seo.canonical_url.trim() || '/solutions/doctcare-ai',
      },
      siteSettings,
      t('page.doctcare.title'),
    )
  : fallbackMetadata(
      '/solutions/doctcare-ai',
      t('page.doctcare.title'),
      failed ? t('home.error') : t('home.empty'),
    );
---
<BaseLayout title={metadata.title} metadata={metadata}>
  <SiteHeader tone="dark" />
  <main id="main" class="solutions-page doctcare-page" data-api-origin={detail.origin}>{page ? (
      <>
        <DoctcareHero page={page} />
        <DoctcareIntro page={page} />
        <DoctcareChallenges page={page} />
        <DoctcareBenefits page={page} />
        <DoctcareCta page={page} />
      </>
    ) : (
      <section class="doctcare-hero">
        <div class="container doctcare-hero-copy summary-region">
          <h1 id="doctcare-heading" class="doctcare-hero-title">{t('page.doctcare.title')}</h1>
          <SectionState error={failed} empty={!failed} />
        </div>
      </section>
    )}
    <HomeInsights blogs={blogsResult.items} error={blogsResult.error} home />
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
