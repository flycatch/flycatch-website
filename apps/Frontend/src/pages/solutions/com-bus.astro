---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home.css';
import '../../styles/com-bus.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeInsights from '../../components/HomeInsights.astro';
import HomeCta from '../../components/HomeCta.astro';
import ComBusHero from '../../components/ComBusHero.astro';
import ComBusTagline from '../../components/ComBusTagline.astro';
import ComBusWhy from '../../components/ComBusWhy.astro';
import ComBusFeatures from '../../components/ComBusFeatures.astro';
import ComBusShowcase from '../../components/ComBusShowcase.astro';
import { loadPublishedBlogs } from '../../lib/public-api';
import { fallbackMetadata } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const blogsResult = await loadPublishedBlogs();
const metadata = fallbackMetadata(
  '/solutions/com-bus',
  t('page.combus.title'),
  t('page.combus.description'),
);
metadata.indexable = true;
---
<BaseLayout title={metadata.title} metadata={metadata}>
  <SiteHeader />
  <main id="main" class="solutions-page combus-page" data-api-origin={blogsResult.origin}>
    <ComBusHero />
    <ComBusTagline />
    <ComBusWhy />
    <ComBusFeatures />
    <ComBusShowcase />
    <HomeInsights blogs={blogsResult.items} error={blogsResult.error} home />
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
<script src="../../scripts/com-bus.ts"></script>
