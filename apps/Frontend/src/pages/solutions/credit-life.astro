---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home.css';
import '../../styles/credit-life.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeInsights from '../../components/HomeInsights.astro';
import HomeCta from '../../components/HomeCta.astro';
import CreditLifeHero from '../../components/CreditLifeHero.astro';
import CreditLifeQuote from '../../components/CreditLifeQuote.astro';
import CreditLifeWhy from '../../components/CreditLifeWhy.astro';
import CreditLifeFeatures from '../../components/CreditLifeFeatures.astro';
import CreditLifeShowcase from '../../components/CreditLifeShowcase.astro';
import CreditLifeStakeholders from '../../components/CreditLifeStakeholders.astro';
import CreditLifeBenefits from '../../components/CreditLifeBenefits.astro';
import { loadPublishedBlogs } from '../../lib/public-api';
import { fallbackMetadata } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const blogsResult = await loadPublishedBlogs();
const metadata = fallbackMetadata(
  '/solutions/credit-life',
  t('page.creditlife.title'),
  t('page.creditlife.description'),
);
metadata.indexable = true;
---
<BaseLayout title={metadata.title} metadata={metadata}>
  <SiteHeader />
  <main id="main" class="solutions-page credit-life-page" data-api-origin={blogsResult.origin}>
    <CreditLifeHero />
    <CreditLifeQuote />
    <CreditLifeWhy />
    <CreditLifeFeatures />
    <CreditLifeShowcase />
    <CreditLifeStakeholders />
    <CreditLifeBenefits />
    <HomeInsights blogs={blogsResult.items} error={blogsResult.error} home />
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
<script src="../../scripts/credit-life.ts"></script>
