---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeServices from '../components/HomeServices.astro';
import HomeCaseStudies from '../components/HomeCaseStudies.astro';
import HomeClients from '../components/HomeClients.astro';
import HomeTestimonials from '../components/HomeTestimonials.astro';
import HomeInsights from '../components/HomeInsights.astro';
import HomeFaq from '../components/HomeFaq.astro';
import HomeCta from '../components/HomeCta.astro';
import SectionState from '../components/SectionState.astro';
import {
  loadPublishedBlogs,
  loadPublishedClientLogos,
  loadPublishedClientTestimonials,
  loadPublishedHomes,
} from '../lib/public-api';
import {
  fallbackMetadata,
  homeStructuredData,
  metadataFromContentSeo,
  publicSiteSettings,
} from '../lib/metadata';
import { t } from '../lib/i18n';

const [homesResult, logosResult, testimonialsResult, blogsResult] = await Promise.all([
  loadPublishedHomes(),
  loadPublishedClientLogos(),
  loadPublishedClientTestimonials(),
  loadPublishedBlogs(),
]);

const siteSettings = publicSiteSettings();
const home = homesResult.items[0] ?? null;
const metadata = home
  ? metadataFromContentSeo(home.seo, siteSettings)
  : fallbackMetadata(
      '/',
      siteSettings.site_name,
      homesResult.error ? t('home.error') : t('home.empty'),
    );
const structuredData = home ? homeStructuredData(home, metadata, siteSettings) : [];
---
<BaseLayout title={metadata.title} metadata={metadata} structuredData={structuredData}>
  <SiteHeader tone="dark" />
  <main id="main" data-api-origin={homesResult.origin}>{home ? (
      <HomeHero home={home} />
    ) : (
      <section class="hero">
        <div class="container hero-copy summary-region">
          <h1>{siteSettings.site_name}</h1>
          <SectionState error={homesResult.error} empty={!homesResult.error} />
        </div>
      </section>
    )}
    <HomeServices services={home?.services ?? []} error={homesResult.error} />
    <HomeCaseStudies studies={home?.case_studies ?? []} error={homesResult.error} />
    <HomeClients logos={logosResult.items} error={logosResult.error} />
    <HomeTestimonials testimonials={testimonialsResult.items} error={testimonialsResult.error} />
    <HomeInsights blogs={blogsResult.items} error={blogsResult.error} />
    <HomeFaq
      title={home?.faq_title ?? ''}
      description={home?.faq_description ?? ''}
      faqs={home?.faqs ?? []}
      error={homesResult.error}
    />
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
