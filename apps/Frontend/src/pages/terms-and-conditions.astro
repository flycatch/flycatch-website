---
export const prerender = true;

import InteriorLayout from '../layouts/InteriorLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionState from '../components/SectionState.astro';
import { loadPublishedLegalPage } from '../lib/public-api';
import {
  buildCanonicalUrl,
  fallbackMetadata,
  metadataFallbackForPath,
  metadataFromContentSeo,
  publicSiteSettings,
} from '../lib/metadata';
import { t } from '../lib/i18n';

const result = await loadPublishedLegalPage('terms', 'terms-and-conditions');
const page = result.item;
const siteSettings = publicSiteSettings();
const path = '/terms-and-conditions';
const metadata = page
  ? {
      ...metadataFromContentSeo(page.seo, siteSettings, metadataFallbackForPath(path)),
      canonical: buildCanonicalUrl(siteSettings.canonical_origin, path),
    }
  : fallbackMetadata(
      path,
      t('page.terms.title'),
      result.error ? t('home.error') : t('page.terms.description'),
    );
metadata.indexable = Boolean(page);
const heading = page?.seo.h1_tag.trim() || page?.title || t('page.terms.title');
---
<InteriorLayout title={metadata.title} metadata={metadata}>
  <SiteHeader />
  <main id="main" class="page-main" data-api-origin={result.origin}>
    <article class="container">
      <SectionState error={result.error} empty={!result.error && !page} />
      <h1>{heading}</h1>
      {page && <div class="body-region" set:html={page.body} />}
    </article>
  </main>
  <SiteFooter />
</InteriorLayout>
