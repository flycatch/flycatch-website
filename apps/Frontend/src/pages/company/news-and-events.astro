---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home.css';
import '../../styles/blogs.css';
import '../../styles/news.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ResourcesTabs from '../../components/ResourcesTabs.astro';
import NewsListing from '../../components/NewsListing.astro';
import HomeCta from '../../components/HomeCta.astro';
import { loadPublishedNewsCategories, loadPublishedNewsPage } from '../../lib/public-api';
import { fallbackMetadata } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const [listed, categories] = await Promise.all([
  loadPublishedNewsPage(1),
  loadPublishedNewsCategories(),
]);
const metadata = fallbackMetadata(
  '/company/news-and-events',
  t('page.news.title'),
  listed.error ? t('home.error') : t('page.news.description'),
);
metadata.indexable = !listed.error;
const structuredData = listed.error
  ? []
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: t('nav.news_events'),
        description: metadata.description,
        url: metadata.canonical,
        mainEntity: {
          '@type': 'ItemList',
          itemListElement: listed.items.map((item, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: item.title,
            url: `${metadata.canonical.replace(/\/$/, '')}/${item.slug}`,
          })),
        },
      },
    ];
---
<BaseLayout title={metadata.title} metadata={metadata} structuredData={structuredData}>
  <SiteHeader />
  <main id="main" class="blogs-page" data-api-origin={listed.origin}>
    <ResourcesTabs active="news" />
    <NewsListing
      items={listed.items}
      categories={categories.items}
      error={listed.error}
      page={listed.page}
      perPage={listed.per_page}
      total={listed.total}
    />
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
