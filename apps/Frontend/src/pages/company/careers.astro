---
export const prerender = true;

import InteriorLayout from '../../layouts/InteriorLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SectionState from '../../components/SectionState.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import { imageAlt } from '../../lib/image';
import {
  loadPublishedEmployeeTestimonials,
  loadPublishedOpenings,
  publicMediaUrl,
} from '../../lib/public-api';
import { fallbackMetadata } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const [openingsResult, storiesResult] = await Promise.all([
  loadPublishedOpenings(),
  loadPublishedEmployeeTestimonials(),
]);
const failed = openingsResult.error && storiesResult.error;
const metadata = fallbackMetadata(
  '/company/careers',
  t('page.careers.title'),
  failed ? t('home.error') : t('page.careers.description'),
);
metadata.indexable = !failed;
---
<InteriorLayout title={metadata.title} metadata={metadata}>
  <SiteHeader />
  <main id="main" class="page-main" data-api-origin={openingsResult.origin}>
    <div class="container summary-region">
      <h1>{t('page.careers.title')}</h1>
      <p class="lede">{t('page.careers.intro')}</p>
      <SectionState error={failed} empty={!failed && openingsResult.items.length === 0 && storiesResult.items.length === 0} />
      <p>
        <a class="btn" href="/company/jobs-openings">{t('page.careers.view_openings')}</a>
      </p>
    </div>
    {openingsResult.items.length > 0 && (
      <section class="container">
        <h2>{t('page.jobs.title')}</h2>
        <ul>
          {openingsResult.items.map((job) => (
            <li>
              <a href={`/company/jobs-openings/${job.slug}`}>{job.role}</a>
              <span>{job.location}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
    {storiesResult.items.length > 0 && (
      <section class="container">
        <h2>{t('page.careers.stories')}</h2>
        <ul>
          {storiesResult.items.map((story) => {
            const image = publicMediaUrl(story.image_key);
            return (
              <li>
                {image && <OptimizedImage src={image} alt={imageAlt(story.name, t('page.careers.stories'))} width={160} height={160} sizes="160px" />}
                <blockquote set:html={story.review} />
                <p>{story.name}</p>
                <p>{story.designation}</p>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </main>
  <SiteFooter />
</InteriorLayout>
