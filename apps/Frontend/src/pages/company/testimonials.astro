---
export const prerender = true;

import InteriorLayout from '../../layouts/InteriorLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeTestimonials from '../../components/HomeTestimonials.astro';
import { loadPublishedClientTestimonials } from '../../lib/public-api';
import { fallbackMetadata } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const listed = await loadPublishedClientTestimonials();
const metadata = fallbackMetadata(
  '/company/testimonials',
  t('page.stories.title'),
  listed.error ? t('home.error') : t('page.stories.description'),
);
metadata.indexable = !listed.error;
---
<InteriorLayout title={metadata.title} metadata={metadata}>
  <SiteHeader />
  <main id="main" class="page-main" data-api-origin={listed.origin}>
    <div class="container summary-region">
      <h1>{t('nav.stories')}</h1>
      <p class="lede">{t('page.stories.intro')}</p>
    </div>
    <HomeTestimonials testimonials={listed.items} error={listed.error} />
  </main>
  <SiteFooter />
</InteriorLayout>
