---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/news-detail.css';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import HomeCta from '../../../components/HomeCta.astro';
import SectionState from '../../../components/SectionState.astro';
import { loadPublishedNews, publicMediaUrl } from '../../../lib/public-api';
import { fallbackMetadata, metadataFromNews, publicSiteSettings } from '../../../lib/metadata';
import { newsStructuredData } from '../../../lib/json-ld';
import { formatNewsDetailDate, youtubeEmbedUrl } from '../../../lib/news-media';
import { t } from '../../../lib/i18n';

const { slug } = Astro.params;
if (!slug) throw new Error('News slug missing');

function escapeAttr(value: string) {
  return value
    .replace(/&/g, '&amp;')
    .replace(/"/g, '&quot;')
    .replace(/</g, '&lt;');
}

function escapeText(value: string) {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function newsBodyHtml(html: string) {
  const withMedia = html.replace(/src=(["'])media:([^"']+)\1/gi, (_match, quote: string, key: string) => {
    const url = publicMediaUrl(decodeURIComponent(key));
    return url ? `src=${quote}${url}${quote}` : `src=${quote}${quote}`;
  });
  return withMedia.replace(/<h1(\s|>)/gi, '<h2$1').replace(/<\/h1>/gi, '</h2>');
}

function ensureImageAlt(html: string, alt: string) {
  return html.replace(/<img\b([^>]*?)>/gi, (full, attrs: string) => {
    if (/\balt\s*=/i.test(attrs)) return full;
    return `<img alt="${escapeAttr(alt)}"${attrs}>`;
  });
}

const result = await loadPublishedNews(slug);
const news = result.item;
if (!news) {
  Astro.response.status = result.error ? 503 : 404;
}
const siteSettings = publicSiteSettings();
const metadata = news
  ? metadataFromNews(news, siteSettings, `/company/news-and-events/${news.slug}`)
  : fallbackMetadata(
      `/company/news-and-events/${slug}`,
      t('page.news.title'),
      result.error ? t('home.error') : t('news.not_found'),
    );
const structuredData = news ? newsStructuredData(news, metadata, siteSettings) : [];
const seoAlt = news?.seo?.image_alt?.trim() ?? '';
const heading = news?.title?.trim() || t('news.not_found');
const imageAlt =
  news && seoAlt && !/^news(\s+(and|&)\s+events)?(\s*\|\s*flycatch)?$/i.test(seoAlt) ? seoAlt : heading;
const publishedOn = news ? formatNewsDetailDate(news.created_at) : '';
const authors = (news?.authors ?? []).filter((author) => author.name.trim());
const categories = (news?.news_categories ?? []).filter((category) => category.name.trim());
const rawBody = news?.body?.trim() ?? '';
const rawDescription = news?.description?.trim() ?? '';
const descriptionIsHtml = /<[a-z][\s\S]*>/i.test(rawDescription);
const sourceHtml = rawBody || (descriptionIsHtml ? rawDescription : '');
let bodyHtml = sourceHtml ? ensureImageAlt(newsBodyHtml(sourceHtml), imageAlt) : '';
if (!bodyHtml && rawDescription) {
  bodyHtml = `<p>${escapeText(rawDescription)}</p>`;
}
const embed = news ? youtubeEmbedUrl(news.youtube_url) : null;
const showEmbed = Boolean(embed && !/youtube\.com|youtu\.be/i.test(bodyHtml));
const coverKey = news?.image_key || news?.seo?.image_key || null;
const cover = publicMediaUrl(coverKey);
const showCover = Boolean(
  cover &&
    !showEmbed &&
    !bodyHtml.includes(cover) &&
    !(coverKey && bodyHtml.includes(coverKey)),
);
const shareLinks = news
  ? [
      { href: news.facebook?.trim() ?? '', label: 'Facebook', icon: 'facebook' },
      { href: news.linkedin?.trim() ?? '', label: 'LinkedIn', icon: 'linkedin' },
      { href: news.instagram?.trim() ?? '', label: 'Instagram', icon: 'instagram' },
      { href: news.twitter?.trim() ?? '', label: 'Twitter', icon: 'twitter' },
    ].filter((item) => item.href)
  : [];
---
<BaseLayout title={metadata.title} metadata={metadata} structuredData={structuredData}>
  <SiteHeader />
  <main id="main" class="news-detail-page" data-api-origin={result.origin}>
    {news ? (
      <article class="news-detail-width news-detail">
        <a class="news-back" href="/company/news-and-events" aria-label={t('news.back_label')}>
          <svg viewBox="64 64 896 896" focusable="false" aria-hidden="true">
            <path fill="currentColor" d="M872 474H286.9l350.2-304c5.6-4.9 2.2-14-5.2-14h-88.5c-3.9 0-7.6 1.4-10.5 3.9L155 487.8a31.96 31.96 0 000 48.3L535.1 866c1.5 1.3 3.3 2 5.2 2h91.5c7.4 0 10.8-9.2 5.2-14L286.9 550H872c4.4 0 8-3.6 8-8v-60c0-4.4-3.6-8-8-8z"></path>
          </svg>
          {t('news.back')}
        </a>
        <h1 data-hero-entrance>{heading}</h1>
        <p class="news-meta">
          <span>{t('news.reading_time', { minutes: news.reading_time })}</span>
          {publishedOn && <time datetime={news.created_at}>{publishedOn}</time>}
        </p>
        {authors.length > 0 && (
          <p class="news-byline">
            <span>{t('news.written_by')}</span>
            <span class="news-author">{authors.map((author) => author.name).join(', ')}</span>
          </p>
        )}
        {shareLinks.length > 0 && (
          <ul class="news-share" aria-label={t('news.share')}>
            {shareLinks.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label}>
                  {item.icon === 'facebook' && (
                    <svg width="32" height="32" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill="currentColor" d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4V10c0-.6.4-1 1-1Z"></path>
                    </svg>
                  )}
                  {item.icon === 'linkedin' && (
                    <svg width="32" height="32" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill="currentColor" d="M6.5 9H4V20h2.5V9ZM5.2 4C4.2 4 3.4 4.8 3.4 5.8s.8 1.8 1.8 1.8 1.8-.8 1.8-1.8S6.3 4 5.2 4ZM20 20h-2.5v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V20H11V9h2.4v1.5c.3-.6 1.2-1.8 3.1-1.8 3.3 0 3.9 2.2 3.9 5V20Z"></path>
                    </svg>
                  )}
                  {item.icon === 'instagram' && (
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.5"></rect>
                      <circle cx="12" cy="12" r="3.75" stroke="currentColor" stroke-width="1.5"></circle>
                      <circle cx="17.2" cy="6.8" r="1" fill="currentColor"></circle>
                    </svg>
                  )}
                  {item.icon === 'twitter' && (
                    <svg width="33" height="32" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill="currentColor" d="M14.7 10.3 22.4 2h-1.8l-6.7 7.2L8.8 2H2.2l8.1 11.2L2.2 22h1.8l7.1-7.6L15.2 22h6.6l-7.1-11.7Zm-2.5 2.7-.8-1.1L4.7 3.3h2.8l5.2 7 .8 1.1 6.8 9.3h-2.8l-5.3-7.4Z"></path>
                    </svg>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )}
        <div class="news-body">
          {showEmbed && embed && (
            <div class="news-embed">
              <iframe
                src={embed}
                title={heading}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          )}
          {showCover && cover && (
            <img class="news-cover" src={cover} alt={imageAlt} width="1040" height="585" />
          )}
          {bodyHtml && <div set:html={bodyHtml} />}
        </div>
        {categories.length > 0 && (
          <ul class="news-tags">
            {categories.map((category) => (
              <li>{category.name}</li>
            ))}
          </ul>
        )}
        <hr class="news-divider" />
      </article>
    ) : (
      <section class="news-detail-width news-detail">
        <a class="news-back" href="/company/news-and-events" aria-label={t('news.back_label')}>
          <svg viewBox="64 64 896 896" focusable="false" aria-hidden="true">
            <path fill="currentColor" d="M872 474H286.9l350.2-304c5.6-4.9 2.2-14-5.2-14h-88.5c-3.9 0-7.6 1.4-10.5 3.9L155 487.8a31.96 31.96 0 000 48.3L535.1 866c1.5 1.3 3.3 2 5.2 2h91.5c7.4 0 10.8-9.2 5.2-14L286.9 550H872c4.4 0 8-3.6 8-8v-60c0-4.4-3.6-8-8-8z"></path>
          </svg>
          {t('news.back')}
        </a>
        <h1 data-hero-entrance>{t('news.not_found')}</h1>
        <SectionState error={result.error} empty={!result.error} />
      </section>
    )}
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
