---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/clients.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeClients from '../../components/HomeClients.astro';
import HomeCta from '../../components/HomeCta.astro';
import { loadPublishedClientLogos } from '../../lib/public-api';
import { fallbackMetadata } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const listed = await loadPublishedClientLogos();
const metadata = fallbackMetadata(
  '/company/clients',
  t('page.clients.title'),
  listed.error ? t('home.error') : t('home.empty'),
);
metadata.indexable = !listed.error;
---
<BaseLayout title={metadata.title} metadata={metadata}>
  <SiteHeader />
  <main id="main" class="clients-page" data-api-origin={listed.origin}>
    <HomeClients logos={listed.items} error={listed.error} />
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
