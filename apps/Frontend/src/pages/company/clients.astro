---
export const prerender = true;

import InteriorLayout from '../../layouts/InteriorLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeClients from '../../components/HomeClients.astro';
import HomeCta from '../../components/HomeCta.astro';
import { loadPublishedClientLogos } from '../../lib/public-api';
import { fallbackMetadata } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const listed = await loadPublishedClientLogos();
const metadata = fallbackMetadata(
  '/company/clients',
  t('page.clients.title'),
  listed.error ? t('home.error') : t('page.clients.description'),
);
metadata.indexable = !listed.error;
---
<InteriorLayout title={metadata.title} metadata={metadata}>
  <SiteHeader showBreadcrumbs={false} />
  <main id="main" class="page-main clients-page" data-api-origin={listed.origin}>
    <div class="container summary-region listing-heading">
      <h1>{t('nav.clients')}</h1>
      <p class="lede">{t('page.clients.intro')}</p>
    </div>
    <HomeClients logos={listed.items} error={listed.error} standalone />
    <HomeCta />
  </main>
  <SiteFooter />
</InteriorLayout>
