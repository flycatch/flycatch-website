---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/home.css';
import '../../../styles/jobs-openings.css';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SectionState from '../../../components/SectionState.astro';
import HomeCta from '../../../components/HomeCta.astro';
import { loadPublishedOpening } from '../../../lib/public-api';
import { fallbackMetadata, publicSiteSettings } from '../../../lib/metadata';
import { openingStructuredData } from '../../../lib/json-ld';
import { t } from '../../../lib/i18n';

const { slug } = Astro.params;
if (!slug) throw new Error('Opening slug missing');

const siteSettings = publicSiteSettings();
const result = await loadPublishedOpening(slug);
const opening = result.item;
const metadata = opening
  ? fallbackMetadata(
      `/company/jobs-openings/${opening.slug}`,
      `${opening.role} | Openings | Flycatch`,
      `${opening.role} — ${opening.location}, ${opening.job_type}.`,
    )
  : fallbackMetadata(
      `/company/jobs-openings/${slug}`,
      t('page.jobs.title'),
      result.error ? t('home.error') : t('home.empty'),
    );
metadata.indexable = Boolean(opening);
const structuredData = opening ? openingStructuredData(opening, metadata, siteSettings) : [];
---
<BaseLayout title={metadata.title} metadata={metadata} structuredData={structuredData}>
  <SiteHeader />
  <main id="main" class="jobs-openings-page" data-api-origin={result.origin}>
    <article class="container jobs-detail">
      <p>
        <a class="jobs-back" href="/company/jobs-openings">Back to openings</a>
      </p>
      <SectionState error={result.error} empty={!result.error && !opening} />
      {opening && (
        <div>
          <h1 class="type-section">{opening.role}</h1>
          <p class="jobs-card-meta">
            <span>{opening.location}</span>
            <span>{opening.experience}</span>
            <span>{opening.job_type}</span>
            <span>{opening.job_status}</span>
            <span>{opening.specialization}</span>
          </p>
          <div class="jobs-body" set:html={opening.body} />
          <p class="jobs-apply-row">
            <a class="btn" href="mailto:opportunity@flycatchtech.com">
              Apply now
              <img src="/icon-arrow-right.svg" width="24" height="24" alt="" />
            </a>
          </p>
        </div>
      )}
    </article>
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
