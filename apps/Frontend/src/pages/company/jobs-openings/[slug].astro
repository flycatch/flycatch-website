---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/home.css';
import '../../../styles/jobs-openings.css';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SectionState from '../../../components/SectionState.astro';
import HomeCta from '../../../components/HomeCta.astro';
import JobApplyForm from '../../../components/JobApplyForm.astro';
import { visitorIp } from '../../../lib/careers-api';
import { loadPublishedOpening } from '../../../lib/public-api';
import { fallbackMetadata, publicSiteSettings } from '../../../lib/metadata';
import { openingStructuredData } from '../../../lib/json-ld';
import { t } from '../../../lib/i18n';
import { renderRichText } from '../../../lib/rich-text';
import { formatApplyBy } from '../../../lib/jobs-board';

const { slug } = Astro.params;
if (!slug) throw new Error('Opening slug missing');

const siteSettings = publicSiteSettings();
const result = await loadPublishedOpening(slug, visitorIp(Astro.request.headers));
const opening = result.item;
if (!opening) {
  Astro.response.status = result.error ? 503 : 404;
}
const metadata = opening
  ? fallbackMetadata(
      `/company/jobs-openings/${opening.slug}`,
      `${opening.role} | Openings | Flycatch`,
      `${opening.role} — ${opening.location}, ${opening.job_type}.`,
    )
  : fallbackMetadata(
      `/company/jobs-openings/${slug}`,
      t('page.jobs.title'),
      result.error ? t('home.error') : t('home.empty'),
    );
metadata.indexable = Boolean(opening);
const bodyHtml = opening ? renderRichText(opening.body) : '';
const applyBy = opening?.exp_date ? formatApplyBy(opening.exp_date) : '';
const canApply = Boolean(opening?.careers?.form && opening.careers.acceptingApplications);
const facts = opening
  ? [
      { label: 'Location', value: opening.location },
      { label: 'Experience', value: opening.experience },
      { label: 'Job type', value: opening.job_type },
      { label: 'Department', value: opening.specialization },
      { label: 'Apply by', value: applyBy },
    ].filter((fact) => fact.value)
  : [];
const structuredData = opening ? openingStructuredData(opening, metadata, siteSettings) : [];
---
<BaseLayout title={metadata.title} metadata={metadata} structuredData={structuredData}>
  <SiteHeader />
  <main id="main" class="page-shell jobs-openings-page" data-api-origin={result.origin}>
    <article class="jobs-detail-wrap">
      <a class="jobs-back" href="/company/jobs-openings">
        <span aria-hidden="true">&larr;</span> Back to openings
      </a>
      <SectionState error={result.error} empty={!result.error && !opening} />
      {opening && (
        <>
          <header class="jobs-detail-head">
            <p class="jobs-detail-eyebrow">{opening.specialization}</p>
            <h1 class="jobs-detail-title" data-hero-entrance>{opening.role}</h1>
            <ul class="jobs-detail-tags">
              {[opening.location, opening.experience, opening.job_type].filter(Boolean).map((tag) => <li>{tag}</li>)}
              {opening.job_status !== 'Open' && <li class="is-paused">{opening.job_status}</li>}
            </ul>
          </header>
          <div class="jobs-detail-layout">
            <div class="jobs-detail-main">
              {bodyHtml
                ? <div class="jobs-richtext" set:html={bodyHtml} />
                : <p class="jobs-richtext">Details for this role will be shared during the process.</p>}
            </div>
            <aside class="jobs-detail-side" aria-label="Role summary">
              <h2 class="jobs-detail-side-title">Role summary</h2>
              <dl class="jobs-detail-facts">
                {facts.map((fact) => (
                  <div>
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))}
              </dl>
              {canApply
                ? <a class="jobs-detail-cta" href="#apply">Apply now</a>
                : !opening.careers && (
                  <a class="jobs-detail-cta" href="mailto:opportunity@flycatchtech.com">Apply by email</a>
                )}
            </aside>
          </div>
          {opening.careers && <JobApplyForm opening={opening.careers} />}
        </>
      )}
    </article>
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
