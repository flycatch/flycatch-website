---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home.css';
import '../../styles/blogs.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ResourcesTabs from '../../components/ResourcesTabs.astro';
import BlogsListing from '../../components/BlogsListing.astro';
import HomeCta from '../../components/HomeCta.astro';
import { apiOrigin, loadPublishedBlogPage, loadPublishedCategories } from '../../lib/public-api';
import { buildCanonicalUrl, fallbackMetadata } from '../../lib/metadata';
import {
  blogListingPageCount,
  blogListingPath,
  parseBlogListingPage,
} from '../../lib/blog-listing';
import { t } from '../../lib/i18n';

const requestedPage = parseBlogListingPage(Astro.url.searchParams.get('page'));
if (requestedPage === null || (requestedPage === 1 && Astro.url.searchParams.has('page'))) {
  return Astro.redirect('/company/blogs', 301);
}

const [listed, categories] = await Promise.all([
  loadPublishedBlogPage(requestedPage),
  loadPublishedCategories(),
]);
const pageCount = listed.error
  ? requestedPage
  : blogListingPageCount(listed.total, listed.per_page);
if (!listed.error && requestedPage > pageCount) {
  return Astro.redirect('/company/blogs', 301);
}
const page = listed.error ? requestedPage : listed.page;
const metadata = fallbackMetadata(
  blogListingPath(page),
  page > 1 ? t('page.blog.paged_title', { page }) : t('page.blog.title'),
  listed.error ? t('home.error') : t('page.blog.description'),
);
metadata.indexable = !listed.error;
const uniqueFromBlogs = [
  ...new Map(
    listed.items.flatMap((blog) => blog.categories).map((category) => [category.name, category]),
  ).values(),
];
const categoryItems = categories.items.length > 0 ? categories.items : uniqueFromBlogs;
const structuredData = listed.error
  ? []
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: t('nav.blogs'),
        description: metadata.description,
        url: metadata.canonical,
        mainEntity: {
          '@type': 'ItemList',
          itemListElement: listed.items.map((blog, index) => ({
            '@type': 'ListItem',
            position: (page - 1) * listed.per_page + index + 1,
            name: blog.title,
            url: buildCanonicalUrl(apiOrigin(), `/company/blogs/${blog.slug}`),
          })),
        },
      },
    ];
---
<BaseLayout title={metadata.title} metadata={metadata} structuredData={structuredData}>
  <SiteHeader />
  <main id="main" class="blogs-page" data-api-origin={listed.origin}>
    <ResourcesTabs active="blogs" />
    <BlogsListing
      blogs={listed.items}
      categories={categoryItems}
      error={listed.error}
      page={page}
      perPage={listed.per_page}
      total={listed.total}
      pageCount={pageCount}
    />
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
