---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeInsights from '../../components/HomeInsights.astro';
import { loadPublishedBlogs } from '../../lib/public-api';
import { fallbackMetadata, publicSiteSettings } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const listed = await loadPublishedBlogs();
const siteSettings = publicSiteSettings();
const metadata = fallbackMetadata(
  '/company/blogs',
  t('nav.blogs'),
  listed.error ? t('home.error') : t('home.empty'),
);
metadata.title = `${t('nav.blogs')} — ${siteSettings.site_name}`;
metadata.indexable = !listed.error;
---
<BaseLayout title={metadata.title} metadata={metadata}>
  <SiteHeader />
  <main id="main" class="page-main" data-api-origin={listed.origin}>
    <div class="container summary-region">
      <h1>{t('nav.blogs')}</h1>
    </div>
    <HomeInsights blogs={listed.items} error={listed.error} limit={0} />
  </main>
  <SiteFooter />
</BaseLayout>
