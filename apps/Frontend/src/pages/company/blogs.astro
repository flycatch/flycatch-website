---
export const prerender = true;

import InteriorLayout from '../../layouts/InteriorLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import HomeInsights from '../../components/HomeInsights.astro';
import HomeCta from '../../components/HomeCta.astro';
import ListingPagination from '../../components/ListingPagination.astro';
import { loadPublishedBlogs } from '../../lib/public-api';
import { fallbackMetadata } from '../../lib/metadata';
import { BLOG_PAGE_SIZE, paginate, parsePageParam } from '../../lib/pagination';
import { t } from '../../lib/i18n';

const listed = await loadPublishedBlogs();
const sorted = [...listed.items].sort(
  (left, right) => Date.parse(right.created_at) - Date.parse(left.created_at),
);
const pageWindow = paginate(sorted, parsePageParam(Astro.url.searchParams.get('page')), BLOG_PAGE_SIZE);
const listTitle =
  pageWindow.page > 1
    ? t('listing.page_title', { title: t('page.blog.title'), page: pageWindow.page })
    : t('page.blog.title');
const metadata = fallbackMetadata(
  pageWindow.page > 1 ? `/company/blogs?page=${pageWindow.page}` : '/company/blogs',
  listTitle,
  listed.error ? t('home.error') : t('page.blog.description'),
);
metadata.indexable = !listed.error;
---
<InteriorLayout title={metadata.title} metadata={metadata}>
  <SiteHeader showBreadcrumbs={false} />
  <main id="main" class="page-main blogs-page" data-api-origin={listed.origin}>
    <div class="container summary-region listing-heading">
      <h1>{listTitle}</h1>
    </div>
    <HomeInsights blogs={pageWindow.items} error={listed.error} limit={0} standalone />
    <div class="container">
      <ListingPagination basePath="/company/blogs" window={pageWindow} />
    </div>
    <HomeCta />
  </main>
  <SiteFooter />
</InteriorLayout>
