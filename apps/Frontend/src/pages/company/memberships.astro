---
export const prerender = true;

import InteriorLayout from '../../layouts/InteriorLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SectionState from '../../components/SectionState.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import { imageAlt } from '../../lib/image';
import { loadPublishedMemberships, publicMediaUrl } from '../../lib/public-api';
import {
  buildCanonicalUrl,
  fallbackMetadata,
  metadataFallbackForPath,
  metadataFromContentSeo,
  publicSiteSettings,
} from '../../lib/metadata';
import { t } from '../../lib/i18n';

const listed = await loadPublishedMemberships();
const first = listed.items[0] ?? null;
const siteSettings = publicSiteSettings();
const metadata = first
  ? {
      ...metadataFromContentSeo(first.seo, siteSettings, metadataFallbackForPath('/company/memberships')),
      canonical: buildCanonicalUrl(siteSettings.canonical_origin, '/company/memberships'),
    }
  : fallbackMetadata(
      '/company/memberships',
      t('page.memberships.title'),
      listed.error ? t('home.error') : t('page.memberships.description'),
    );
metadata.indexable = !listed.error;
---
<InteriorLayout title={metadata.title} metadata={metadata}>
  <SiteHeader />
  <main id="main" class="page-main" data-api-origin={listed.origin}>
    <div class="container summary-region">
      <h1>{t('page.memberships.title')}</h1>
      <p class="lede">{t('page.memberships.intro')}</p>
      <SectionState error={listed.error} empty={!listed.error && listed.items.length === 0} />
      <ul>
        {listed.items.map((item) => (
          <li>
            <h2>{item.title}</h2>
            <div class="body-region" set:html={item.description} />
            {item.images.map((image) => {
              const src = publicMediaUrl(image.image_key);
              return src ? <OptimizedImage src={src} alt={imageAlt(image.alt, item.title)} width={240} height={120} sizes="240px" /> : null;
            })}
          </li>
        ))}
      </ul>
    </div>
  </main>
  <SiteFooter />
</InteriorLayout>
