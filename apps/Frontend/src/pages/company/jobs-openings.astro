---
export const prerender = true;

import InteriorLayout from '../../layouts/InteriorLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SectionState from '../../components/SectionState.astro';
import { loadPublishedOpenings } from '../../lib/public-api';
import { fallbackMetadata } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const listed = await loadPublishedOpenings();
const metadata = fallbackMetadata(
  '/company/jobs-openings',
  t('page.jobs.title'),
  listed.error ? t('home.error') : t('page.jobs.description'),
);
metadata.indexable = !listed.error;
---
<InteriorLayout title={metadata.title} metadata={metadata}>
  <SiteHeader />
  <main id="main" class="page-main" data-api-origin={listed.origin}>
    <div class="container summary-region">
      <h1>{t('page.jobs.title')}</h1>
      <p class="lede">{t('page.jobs.intro')}</p>
      <SectionState error={listed.error} empty={!listed.error && listed.items.length === 0} />
      <ul>
        {listed.items.map((job) => (
          <li>
            <a href={`/company/jobs-openings/${job.slug}`}>{job.role}</a>
            <p>{job.location} · {job.job_type} · {job.experience}</p>
          </li>
        ))}
      </ul>
    </div>
  </main>
  <SiteFooter />
</InteriorLayout>
