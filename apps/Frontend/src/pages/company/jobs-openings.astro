---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home.css';
import '../../styles/jobs-openings.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import JobsOpeningsBoard from '../../components/JobsOpeningsBoard.astro';
import HomeCta from '../../components/HomeCta.astro';
import { loadPublishedOpenings } from '../../lib/public-api';
import { fallbackMetadata } from '../../lib/metadata';
import { t } from '../../lib/i18n';

const listed = await loadPublishedOpenings();
const metadata = fallbackMetadata(
  '/company/jobs-openings',
  t('page.jobs.title'),
  'Current openings at Flycatch. Send your resume to opportunity@flycatchtech.com if you do not see a match.',
);
metadata.indexable = !listed.error;
const structuredData = listed.error
  ? []
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'Current openings',
        itemListElement: listed.items.map((job, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: job.role,
          url: `${metadata.canonical.replace(/\/$/, '')}/${job.slug}`,
        })),
      },
    ];
---
<BaseLayout title={metadata.title} metadata={metadata} structuredData={structuredData}>
  <SiteHeader />
  <main id="main" class="jobs-openings-page" data-api-origin={listed.origin}>
    <JobsOpeningsBoard openings={listed.items} error={listed.error} />
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
