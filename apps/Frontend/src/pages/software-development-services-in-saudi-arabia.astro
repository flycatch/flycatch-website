---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeOfferings from '../components/HomeOfferings.astro';
import HomeServices from '../components/HomeServices.astro';
import HomeContact from '../components/HomeContact.astro';
import HomeCaseStudies from '../components/HomeCaseStudies.astro';
import HomeMinds from '../components/HomeMinds.astro';
import HomeClients from '../components/HomeClients.astro';
import HomeTestimonials from '../components/HomeTestimonials.astro';
import HomeInsights from '../components/HomeInsights.astro';
import HomeFaq from '../components/HomeFaq.astro';
import HomeCta from '../components/HomeCta.astro';
import SectionState from '../components/SectionState.astro';
import {
  loadPublishedBlogs,
  loadPublishedClientLogos,
  loadPublishedClientTestimonials,
  loadPublishedFlycatchSaudiArabiaPage,
  loadPublishedHomes,
  saudiSectionToHomeService,
} from '../lib/public-api';
import { fallbackMetadata, metadataFromContentSeo, publicSiteSettings } from '../lib/metadata';
import { t } from '../lib/i18n';

const pagePath = '/software-development-services-in-saudi-arabia';
const [saudiResult, homesResult, logosResult, testimonialsResult, blogsResult] = await Promise.all([
  loadPublishedFlycatchSaudiArabiaPage(),
  loadPublishedHomes(),
  loadPublishedClientLogos(),
  loadPublishedClientTestimonials(),
  loadPublishedBlogs(),
]);
const home = homesResult.items[0] ?? null;

const siteSettings = publicSiteSettings();
const page = saudiResult.item;
const services = (page?.service_section ?? []).map(saudiSectionToHomeService);
const metadata = page
  ? metadataFromContentSeo(page.seo, siteSettings, t('page.saudi.title'))
  : fallbackMetadata(
      pagePath,
      t('page.saudi.title'),
      saudiResult.error ? t('home.error') : t('home.empty'),
    );
if (page && !page.seo.canonical_url.trim()) {
  metadata.canonical = fallbackMetadata(pagePath, metadata.title, metadata.description).canonical;
}
const structuredData = page
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: siteSettings.site_name,
        url: siteSettings.canonical_origin,
      },
      {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: page.banner_title.trim() || page.seo.h1_tag.trim() || metadata.title,
        description: metadata.description,
        url: metadata.canonical,
      },
    ]
  : [];
---
<BaseLayout title={metadata.title} metadata={metadata} structuredData={structuredData}>
  <SiteHeader tone="dark" />
  <main id="main" class="home-page" data-api-origin={saudiResult.origin}>{page ? (
      <HomeHero home={page} exploreLabel={page.banner_explore_text} />
    ) : (
      <section class="hero">
        <div class="container hero-copy summary-region">
          <h1>{siteSettings.site_name}</h1>
          <SectionState error={saudiResult.error} empty={!saudiResult.error} />
        </div>
      </section>
    )}
    <HomeOfferings />
    <HomeServices services={services} title={page?.services_title ?? ''} error={saudiResult.error} />
    <HomeContact />
    <HomeMinds />
    <HomeCaseStudies studies={home?.case_studies ?? []} error={homesResult.error} home />
    <HomeClients logos={logosResult.items} error={logosResult.error} home />
    <HomeTestimonials
      testimonials={testimonialsResult.items}
      error={testimonialsResult.error}
      home
    />
    <HomeInsights blogs={blogsResult.items} error={blogsResult.error} home />
    <HomeFaq
      title={home?.faq_title ?? ''}
      description={home?.faq_description ?? ''}
      faqs={home?.faqs ?? []}
      error={homesResult.error}
    />
    <HomeCta />
  </main>
  <SiteFooter />
</BaseLayout>
