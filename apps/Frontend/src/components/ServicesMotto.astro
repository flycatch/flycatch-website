---
import { t } from '../lib/i18n';
---
<section class="services-motto" aria-labelledby="services-motto-heading">
  <div class="container services-motto-inner">
    <div class="services-motto-copy">
      <p class="services-motto-eyebrow">{t('page.services.motto_eyebrow')}</p>
      <h2 id="services-motto-heading">{t('page.services.motto')}</h2>
    </div>
    <figure class="services-motto-media">
      <img
        src="/services/bulbImage.webp"
        alt={t('page.services.motto_image_alt')}
        width="330"
        height="480"
        loading="lazy"
      />
    </figure>
  </div>
</section>
