---
import { t } from '../lib/i18n';
import { resourcesTabs, type ResourcesTabId } from '../lib/nav';

interface Props {
  active: ResourcesTabId;
  search?: boolean;
}

const { active, search = true } = Astro.props;
---
<div class="resources-tabs" data-resources-tabs>
  <div class="container">
    <div class="resources-tabs-inner">
    <nav class="resources-tabs-nav" aria-label={t('resources.tabs')}>
      {resourcesTabs.map((tab) => (
        <a
          class:list={['resources-tab', { 'is-active': tab.id === active }]}
          href={tab.href}
          aria-current={tab.id === active ? 'page' : undefined}
        >
          {t(tab.labelKey)}
        </a>
      ))}
    </nav>
    {search && (
    <label class="resources-search">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="2"></circle>
        <path d="M21 21l-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <input
        type="search"
        data-resources-search
        placeholder={t('resources.search')}
        aria-label={t('resources.search')}
        autocomplete="off"
      />
      <span class="resources-search-mirror" data-resources-search-mirror aria-hidden="true">{t('resources.search')}</span>
    </label>
    )}
    </div>
  </div>
</div>
<script src="../scripts/resources-tabs.ts"></script>
