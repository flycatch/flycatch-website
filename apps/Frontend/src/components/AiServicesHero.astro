---
import { publicMediaUrl } from '../lib/public-api';
import type { PublicAiService } from '../lib/public-api';

interface Props {
  page: PublicAiService;
}

const { page } = Astro.props;
const banner = publicMediaUrl(page.banner_image_key);
const heading = page.banner_title.trim();
---
<section class="ai-hero" aria-labelledby="ai-heading">{banner ? (
    <img
      class="ai-hero-media"
      src={banner}
      alt={page.seo.image_alt || page.banner_title}
      width="1512"
      height="982"
    />
  ) : (
    <div class="ai-hero-media ai-hero-fallback"></div>
  )}
  <div class="ai-hero-overlay" aria-hidden="true"></div>
  <div class="ai-hero-scrim" aria-hidden="true"></div>
  <div class="container ai-hero-copy">
    <h1 id="ai-heading" class="type-display-lg" hidden={!heading}>{heading}</h1>
  </div>
</section>

<script>
  const heading = document.getElementById('ai-heading');
  if (heading) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          } else {
            entry.target.classList.remove('is-visible');
          }
        });
      },
      {
        threshold: 0.1,
      }
    );
    observer.observe(heading);
  }
</script>
