---
import { publicMediaUrl } from '../lib/public-api';
import type { PublicSolution } from '../lib/public-api';

interface Props {
  page: PublicSolution;
}

const { page } = Astro.props;
const banner = publicMediaUrl(page.banner_image_key);
const heading = page.banner_title.trim();
---
<section class="solutions-hero" aria-labelledby="solutions-heading">{banner ? (
    <img
      class="solutions-hero-media"
      src={banner}
      alt={page.seo.image_alt || page.banner_title}
      width="1512"
      height="982"
    />
  ) : (
    <div class="solutions-hero-media solutions-hero-fallback"></div>
  )}
  <div class="solutions-hero-overlay" aria-hidden="true"></div>
  <div class="solutions-hero-scrim" aria-hidden="true"></div>
  <div class="container solutions-hero-copy">
    <h1 id="solutions-heading" class="type-display-lg solutions-banner-heading" hidden={!heading} data-hero-entrance>{heading}</h1>
  </div>
</section>
