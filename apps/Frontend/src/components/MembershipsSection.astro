---
import { t } from '../lib/i18n';
import { cmsRichContent, publicMediaUrl } from '../lib/public-api';
import type { PublicMembership } from '../lib/public-api';
import DoctcareCmsText from './DoctcareCmsText.astro';
import SectionState from './SectionState.astro';

interface Props {
  membership: PublicMembership | null;
  error?: boolean;
  loading?: boolean;
}

const { membership, error = false, loading = false } = Astro.props;
const title = membership?.title.trim() || membership?.seo.h1_tag.trim() || '';
const description = cmsRichContent(membership?.description);
const images = (membership?.images ?? [])
  .map((image) => ({
    src: publicMediaUrl(image.image_key),
    alt: image.alt.trim() || title,
  }))
  .filter((image): image is { src: string; alt: string } => Boolean(image.src));
const hasContent = Boolean(title || description.html || description.text || images.length);
const heading = title || t('nav.memberships');
---
<section class="memberships-section" aria-busy={loading ? 'true' : 'false'}>
  <div class="container">
    {loading ? (
      <>
        <h1 class="memberships-title">{t('nav.memberships')}</h1>
        <SectionState loading />
      </>
    ) : error ? (
      <>
        <h1 class="memberships-title">{t('nav.memberships')}</h1>
        <SectionState error />
      </>
    ) : !membership || !hasContent ? (
      <>
        <h1 class="memberships-title">{t('nav.memberships')}</h1>
        <SectionState empty />
      </>
    ) : (
      <>
        <h1 class="memberships-title">{heading}</h1>
        {(description.html || description.text) && (
          <DoctcareCmsText class="memberships-description" value={membership.description} />
        )}
        {images.length > 0 && (
          <ul class="memberships-grid">
            {images.map((image) => (
              <li class="memberships-card">
                <img src={image.src} alt={image.alt} loading="eager" decoding="async" />
              </li>
            ))}
          </ul>
        )}
      </>
    )}
  </div>
</section>
