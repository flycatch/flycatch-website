---
import { procureFlexCopy as copy } from '../lib/procure-flex-data';
---
<section class="pf-showcase" aria-label={copy.showcase.body}>
  <div class="container pf-showcase-inner">
    <div class="pf-showcase-media" data-section-reveal data-reveal="rise">
      <img
        src="/procure-flex/showcase.webp"
        alt={copy.showcase.imageAlt}
        width="703"
        height="491"
        loading="lazy"
      />
    </div>
    <p class="pf-showcase-body" data-section-reveal data-reveal="rise">{copy.showcase.body}</p>
  </div>
</section>
