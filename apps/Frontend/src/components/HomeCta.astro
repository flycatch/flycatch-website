---
import { t } from '../lib/i18n';
import { contactHref } from '../lib/nav';
---
<section class="section section-cta" id="book-call">
  <div class="container cta-banner">
    <h2 class="type-cta">{t('home.cta_title')}</h2>
    {contactHref && (
    <a class="btn cta-book-btn" href={contactHref}>
      {t('home.cta_action')}
      <img src="/icon-arrow-right.svg" width="24" height="24" alt="" />
    </a>
    )}
  </div>
</section>
