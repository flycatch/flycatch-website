---
import { t } from '../lib/i18n';

const pillars = [
  {
    title: t('page.application_modernization.pillar_1_title'),
    paragraphs: [
      t('page.application_modernization.pillar_1_1'),
      t('page.application_modernization.pillar_1_2'),
      t('page.application_modernization.pillar_1_3'),
    ],
  },
  {
    title: t('page.application_modernization.pillar_2_title'),
    paragraphs: [
      t('page.application_modernization.pillar_2_1'),
      t('page.application_modernization.pillar_2_2'),
      t('page.application_modernization.pillar_2_3'),
    ],
  },
  {
    title: t('page.application_modernization.pillar_3_title'),
    paragraphs: [
      t('page.application_modernization.pillar_3_1'),
      t('page.application_modernization.pillar_3_2'),
      t('page.application_modernization.pillar_3_3'),
    ],
  },
];
---
<section class="modernization-pillars" aria-labelledby="modernization-pillars-heading">
  <div class="container modernization-pillars-layout">
    <div class="modernization-pillars-left">
      <h2 id="modernization-pillars-heading">{t('page.application_modernization.pillars_title')}</h2>
      <p>{t('page.application_modernization.pillars_description')}</p>
      <img
        class="modernization-pillars-media"
        src="/application-modernization/dart-and-target.webp"
        alt=""
        width="479"
        height="490"
        loading="lazy"
      />
    </div>
    <div class="modernization-pillars-right">
      {pillars.map((pillar, index) => (
        <>
          {index > 0 && <hr class="modernization-pillar-divider" />}
          <div class="modernization-pillar">
            <h3>{pillar.title}</h3>
            {pillar.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </>
      ))}
    </div>
  </div>
</section>
