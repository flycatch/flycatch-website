---
import { t } from '../lib/i18n';
import { publicMediaUrl } from '../lib/public-api';
import type { HomeService } from '../lib/public-api';
import SectionState from './SectionState.astro';

interface Props {
  services: HomeService[];
  error?: boolean;
}

const { services, error = false } = Astro.props;
---
<section class="section" id="services">
  <div class="container">
    <h2>{t('home.services')}</h2>
    <SectionState error={error} empty={!error && services.length === 0} />
    {services.length > 0 && (
      <div class="service-grid">
        {services.map((service) => {
          const image = publicMediaUrl(service.services_image_key);
          const href = service.our_services_links.trim();
          return (
            <article class="service-panel">
              {image ? (
                <div class="media-frame service-media">
                  <img
                    src={image}
                    alt={service.services_types_title}
                    width="581"
                    height="360"
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="media-frame service-media"></div>
              )}
              <div class="service-copy">
                <h3>{service.services_types_title}</h3>
                <p>{service.services_contents}</p>
                {href && (
                  <a class="service-know-more" href={href}>
                    {t('home.know_more')}
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</section>
