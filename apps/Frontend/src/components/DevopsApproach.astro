---
import { devopsApproach } from '../lib/devops-static';
---
<section class="devops-approach" aria-labelledby="devops-approach-heading">
  <div class="container devops-approach-inner">
    <h2 id="devops-approach-heading" class="type-section">{devopsApproach.title}</h2>
    <p class="type-lede">{devopsApproach.description}</p>
    <div class="devops-approach-media">
      <img
        data-ucd-reveal
        src={devopsApproach.topImage}
        alt=""
        width="1916"
        height="796"
        loading="lazy"
      />
      <img
        data-ucd-reveal
        src={devopsApproach.bottomImage}
        alt=""
        width="1916"
        height="818"
        loading="lazy"
        style="transition-delay: 600ms"
      />
    </div>
  </div>
</section>
<script src="../scripts/ucd-approach.ts"></script>
