---
import { procureFlexCopy as copy } from '../lib/procure-flex-data';
---
<section class="pf-why" aria-labelledby="pf-why-heading">
  <div class="container pf-why-inner">
    <div class="pf-why-media" data-section-reveal data-reveal="rise">
      <img
        src="/procure-flex/why.webp"
        alt={copy.why.imageAlt}
        width="581"
        height="540"
        loading="lazy"
      />
    </div>
    <div class="pf-why-copy" data-section-reveal data-reveal="rise">
      <h2 id="pf-why-heading" class="pf-display">
        {copy.why.heading}
      </h2>
      <p class="pf-why-body">{copy.why.body}</p>
    </div>
  </div>
</section>
