---
import type { PublicOpening } from '../lib/public-api';
import SectionState from './SectionState.astro';
import {
  countryOptions,
  facetOptions,
  formatApplyBy,
  placeOptions,
  sortCards,
  toJobCard,
} from '../lib/jobs-board';

interface Props {
  openings: PublicOpening[];
  error?: boolean;
}

const { openings, error = false } = Astro.props;
const cards = sortCards(openings.map((job) => toJobCard(job)));
const total = cards.length;

// One site lists every legal entity's openings, so location leads the filters.
const countries = countryOptions(cards);
const places = placeOptions(cards);
const depts = facetOptions(cards, (card) => (card.dept ? [card.dept] : []));
const modes = facetOptions(cards, (card) => (card.mode ? [card.mode] : []));
const types = facetOptions(cards, (card) => (card.type ? [card.type] : []));
const selects = [
  { key: 'location', label: 'Location', all: 'Location', options: places },
  { key: 'dept', label: 'Department', all: 'Department', options: depts },
  { key: 'mode', label: 'Work mode', all: 'Work mode', options: modes },
  { key: 'type', label: 'Job type', all: 'Job type', options: types },
].filter((select) => select.options.length > 1);

const roles = (n: number) => `${n} ${n === 1 ? 'role' : 'roles'}`;
const where = countries.map((c) => c.label);
const whereText = where.length > 1 ? `${where.slice(0, -1).join(', ')} and ${where.at(-1)}` : where[0];
---
<section id="job_opening_section" class="jobs-live" data-jobs-live>
  <div class="jobs-live-inner">
    <div class="jobs-live-head">
      <h1 class="jobs-live-title" data-hero-entrance>Current openings</h1>
      <a class="jobs-live-status" href="/company/jobs-openings/status">Check my application</a>
    </div>
    <p class="jobs-live-desc">
      {total > 0 && !error && <>{roles(total)} open{whereText && ` across ${whereText}`}. </>}
      Together, we redefine collaboration, forging a shared path towards excellence, where your success is our top priority. If you couldn't find a suitable job opening, please feel free to send your resume to{' '}
      <a class="jobs-live-email" href="mailto:opportunity@flycatchtech.com">opportunity@flycatchtech.com</a>
    </p>

    <SectionState error={error} />
    {!error && total === 0 && <p class="jobs-live-empty">There are no open roles right now.</p>}

    {!error && total > 0 && (
      <>
        <form class="jobs-live-filters" role="search" aria-label="Filter openings" data-jobs-filters>
          <label class="jobs-live-search">
            <span class="visually-hidden">Search roles or skills</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <input type="search" name="q" placeholder="Search roles or skills" autocomplete="off" data-jobs-filter="q" />
          </label>
          {selects.map((select) => (
            <label class="jobs-live-field">
              <span class="visually-hidden">{select.label}</span>
              <select name={select.key} data-jobs-filter={select.key}>
                <option value="">{select.all}</option>
                {select.options.map((option) => (
                  <option value={option.value} data-country={option.country}>{option.label} ({option.count})</option>
                ))}
              </select>
            </label>
          ))}
        </form>

        {countries.length > 0 && (
          <div class="jobs-live-chips" role="group" aria-label="Country">
            <button type="button" class="jobs-live-chip" data-jobs-country="" aria-pressed="true">
              All countries <span>{total}</span>
            </button>
            {countries.map((country) => (
              <button type="button" class="jobs-live-chip" data-jobs-country={country.value} aria-pressed="false">
                {country.label} <span>{country.count}</span>
              </button>
            ))}
          </div>
        )}

        <div class="jobs-live-summary">
          <p aria-live="polite" data-jobs-summary>Showing {roles(total)}</p>
          <button type="button" class="jobs-live-clear" data-jobs-clear hidden>Clear filters</button>
        </div>

        <ul class="jobs-live-list" data-jobs-list>
          {cards.map((card) => (
            <li
              class:list={['jobs-live-card', { 'is-paused': card.paused }]}
              data-jobs-card
              data-search={card.facets.search}
              data-countries={card.facets.countries.join('|')}
              data-places={card.facets.places.join('|')}
              data-dept={card.facets.dept}
              data-mode={card.facets.mode}
              data-type={card.facets.type}
            >
              <div class="jobs-live-copy">
                <h2 class="jobs-live-role">
                  <a href={`/company/jobs-openings/${card.slug}`}>{card.role}</a>
                  {card.isNew && <span class="jobs-live-badge is-new">New</span>}
                  {card.paused && <span class="jobs-live-badge">Paused</span>}
                </h2>
                <p class="jobs-live-meta">
                  {[card.dept, card.places.join(', '), card.mode, card.type, card.experience && `${card.experience} experience`]
                    .filter(Boolean)
                    .join(' · ')}
                </p>
                {card.skills.length > 0 && (
                  <ul class="jobs-live-skills" aria-label="Key skills">
                    {card.skills.map((skill) => <li>{skill}</li>)}
                  </ul>
                )}
              </div>
              <div class="jobs-live-side">
                {!card.paused && card.applyBy && formatApplyBy(card.applyBy) && (
                  <p class="jobs-live-deadline">Apply by {formatApplyBy(card.applyBy)}</p>
                )}
                <span class="jobs-live-apply" aria-hidden="true">
                  {card.paused ? 'View role' : 'Apply now'}
                  <span class="jobs-live-apply-icon">
                    <svg class="jobs-live-apply-icon-default" width="21" height="21" viewBox="0 0 20 21" fill="none">
                      <path d="M4.16602 10.5H15.8327" stroke="#E50914" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M10 4.66663L15.8333 10.5L10 16.3333" stroke="#E50914" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    <svg class="jobs-live-apply-icon-hover" width="21" height="21" viewBox="0 0 21 21" fill="none">
                      <path d="M6.33337 14.6666L14.6667 6.33325" stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M6.33337 6.33325H14.6667V14.6666" stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                </span>
              </div>
            </li>
          ))}
        </ul>

        <div class="jobs-live-empty" data-jobs-empty hidden>
          <p>No roles match your filters.</p>
          <button type="button" class="jobs-live-clear" data-jobs-clear>Clear filters</button>
        </div>
      </>
    )}
  </div>
</section>
<script src="../scripts/jobs-openings-board.ts"></script>
