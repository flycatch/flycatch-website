---
import CoverflowLaptopSlider from './CoverflowLaptopSlider.astro';
import { aiChatSupportCopy as copy } from '../lib/ai-chat-support-data';
---
<section class="acs-showcase" aria-label={copy.showcase.body}>
  <div class="container acs-showcase-copy">
    <p class="acs-showcase-body" data-section-reveal data-reveal="rise">{copy.showcase.body}</p>
  </div>
  <CoverflowLaptopSlider
    slides={copy.showcase.slides}
    mobileSrc="/ai-chat-support/laptop-mobile.webp"
    mobileAlt={copy.showcase.imageAlt}
  />
</section>
