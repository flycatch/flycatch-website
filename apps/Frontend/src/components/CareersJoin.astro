---
---
<section class="careers-join">
  <div class="container careers-join-grid">
    <div class="careers-join-copy">
      <p class="careers-tagline" style="font-size: 20px; font-weight: 400; color: #ffffff;">We Work With Great Minds</p>
      <h2 class="type-section">Join Our Team Exciting Job Opportunities</h2>
      <p class="lede type-lede">
        At Flycatch, we believe that those who challenge the status quo today will do remarkable things tomorrow.
      </p>
      <div class="careers-btn-row careers-join-actions">
        <a class="btn btn-on-dark" href="/company/jobs-openings">
          <span>View all openings</span>
          <img src="/icon-arrow-right.svg" width="24" height="24" alt="" />
        </a>
        <a class="btn btn-on-dark" href="/company/jobs-openings?type=Contract">
          <span>View all contract openings</span>
          <img src="/icon-arrow-right.svg" width="24" height="24" alt="" />
        </a>
      </div>
    </div>
    <div class="careers-join-media">
      <img
        src="/company/careers/join_our_team_bg.webp"
        alt=""
        width="640"
        height="480"
        loading="lazy"
      />
    </div>
  </div>
</section>
