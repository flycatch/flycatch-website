---
import { t } from '../lib/i18n';

const services = [
  {
    title: t('page.user_centered_design.service_1'),
    background: '/user-centered-design/serviceBg-1.webp',
    icon: '/user-centered-design/serviceMobileIcon-1.svg',
  },
  {
    title: t('page.user_centered_design.service_2'),
    background: '/user-centered-design/serviceBg-2.webp',
    icon: '/user-centered-design/serviceMobileIcon-2.svg',
  },
  {
    title: t('page.user_centered_design.service_3'),
    background: '/user-centered-design/serviceBg-3.webp',
    icon: '/user-centered-design/serviceMobileIcon-3.svg',
  },
  {
    title: t('page.user_centered_design.service_4'),
    background: '/user-centered-design/serviceBg-4.webp',
    icon: '/user-centered-design/serviceMobileIcon-4.svg',
  },
];
---
<section class="ucd-services" aria-labelledby="ucd-services-heading">
  <div class="ucd-services-desktop">
    <div class="container ucd-services-wrap">
      <div class="ucd-services-left">
        <h2 id="ucd-services-heading" class="type-section">{t('page.user_centered_design.services_title')}</h2>
        <p class="type-lede">{t('page.user_centered_design.services_description')}</p>
      </div>
      <div class="ucd-services-right">
        {services.map((service) => (
          <div
            class="ucd-services-panel"
            style={`background-image: url('${service.background}')`}
          >
            <h3 class="type-section">{service.title}</h3>
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="ucd-services-mobile">
    <div class="container ucd-services-mobile-intro">
      <h2 class="type-section">{t('page.user_centered_design.services_title')}</h2>
      <p class="type-lede">{t('page.user_centered_design.services_description')}</p>
    </div>
    {services.map((service) => (
      <div class="ucd-services-card">
        <div class="container ucd-services-card-inner">
          <img src={service.icon} alt="" width="116" height="100" loading="lazy" />
          <h3 class="type-section">{service.title}</h3>
        </div>
      </div>
    ))}
  </div>
</section>
