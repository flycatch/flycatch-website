---
import { devopsToolsFallback } from '../lib/devops-static';

const { title, description, image } = devopsToolsFallback;
---
<section class="devops-tools" aria-labelledby="devops-tools-heading">
  <div class="container devops-tools-inner">
    <h2 id="devops-tools-heading" class="type-section">{title}</h2>
    <p class="type-lede">{description}</p>
    <img src={image} alt="" width="1200" height="700" loading="lazy" />
  </div>
</section>
