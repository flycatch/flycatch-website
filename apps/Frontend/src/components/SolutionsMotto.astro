---
import { t } from '../lib/i18n';
---
<section class="solutions-motto" aria-labelledby="solutions-motto-heading">
  <div class="container solutions-motto-inner">
    <div class="solutions-motto-copy">
      <p class="solutions-motto-eyebrow">{t('page.solutions.motto_eyebrow')}</p>
      <h2 id="solutions-motto-heading" class="type-display">{t('page.solutions.motto')}</h2>
    </div>
    <figure class="solutions-motto-media">
      <img
        src="/solutions/motto-light.png"
        alt={t('page.solutions.motto_image_alt')}
        width="330"
        height="480"
        loading="lazy"
      />
    </figure>
  </div>
</section>
