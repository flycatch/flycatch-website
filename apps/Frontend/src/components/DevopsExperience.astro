---
import { cmsRichContent, publicMediaUrl, sortByOrder } from '../lib/public-api';
import type { PublicAccordionItem } from '../lib/public-api';

interface Props {
  title?: string;
  description?: string;
  imageKey?: string | null;
  items: PublicAccordionItem[];
}

const { title = '', description = '', imageKey = null, items } = Astro.props;
const heading = title.trim();
const body = cmsRichContent(description);
const image = publicMediaUrl(imageKey);
const rows = sortByOrder(items)
  .filter((item) => item.title.trim() || item.contents.trim())
  .map((item) => ({
    ...item,
    body: cmsRichContent(item.contents),
  }));
const show = Boolean(heading || body.html || body.text || image || rows.length);
---
{show && (
  <section class="devops-experience ads-offerings" aria-labelledby="devops-experience-heading">
    <div class="container">
      <h2 id="devops-experience-heading" class="type-section" hidden={!heading}>{heading}</h2>
      <div
        class="ads-offerings-description type-lede"
        hidden={!(body.html || body.text)}
        set:html={body.html || body.text}
      ></div>
      <div class="ads-offerings-body" hidden={!(image || rows.length)}>
        <div class="ads-offerings-media" hidden={!image}>
          {image && <img src={image} alt="" width="375" height="450" loading="lazy" />}
        </div>
        <div class="ads-offerings-list">
          {rows.map((item) => (
            <details class="ads-accordion">
              <summary>
                <span>{item.title}</span>
                <img src="/icon-expand-more.svg" width="40" height="40" alt="" />
              </summary>
              {item.body.html ? (
                <div class="ads-accordion-body type-lede" set:html={item.body.html}></div>
              ) : (
                <div class="ads-accordion-body type-lede">{item.body.text}</div>
              )}
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
