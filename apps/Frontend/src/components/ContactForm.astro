---
import FormExtras from './FormExtras.astro';
import { t } from '../lib/i18n';

const submitted = Astro.url.searchParams.get('submitted') === 'contact';
const failed = Astro.url.searchParams.get('form_error') === 'contact';
---
<form class="public-form" action="/api/forms/contact" method="post" data-public-form="contact" novalidate>
  <p class="form-status" data-form-status role="status" aria-live="polite">
    {submitted ? t('form.success.contact') : ''}
    {failed ? t('form.error.generic') : ''}
  </p>
  <fieldset>
    <legend>{t('form.contact.type_legend')}</legend>
    <label>
      <input type="radio" name="contact_type" value="PARTNERSHIP" data-contact-type />
      {t('form.contact.partnership')}
    </label>
    <label>
      <input type="radio" name="contact_type" value="GENERAL_ENQUIRY" checked data-contact-type />
      {t('form.contact.general')}
    </label>
    <label>
      <input type="radio" name="contact_type" value="GET_A_QUOTE" data-contact-type />
      {t('form.contact.quote')}
    </label>
  </fieldset>
  <label>
    {t('form.first_name')}
    <input type="text" name="name" autocomplete="given-name" required />
  </label>
  <label>
    {t('form.last_name')}
    <input type="text" name="last_name" autocomplete="family-name" required />
  </label>
  <label>
    {t('form.email')}
    <input type="email" name="email" autocomplete="email" required />
  </label>
  <label>
    {t('form.phone')}
    <input type="tel" name="phone" autocomplete="tel" required />
  </label>
  <label data-for-types="PARTNERSHIP">
    {t('form.company')}
    <input type="text" name="company_name" autocomplete="organization" />
  </label>
  <label data-for-types="GENERAL_ENQUIRY">
    {t('form.subject')}
    <input type="text" name="subject" />
  </label>
  <label data-for-types="PARTNERSHIP GET_A_QUOTE">
    {t('form.details')}
    <textarea name="details" rows="4"></textarea>
  </label>
  <FormExtras returnTo="/contact-us" />
  <button type="submit">{t('form.submit')}</button>
</form>
