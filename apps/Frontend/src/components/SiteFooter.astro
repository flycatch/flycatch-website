---
import { t } from '../lib/i18n';
import { footerCompany, footerOthers, footerServices, socialLinks } from '../lib/nav';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="subscribe">
        <h2 class="type-section">{t('footer.subscribe_title')}</h2>
        <p>{t('footer.subscribe_body')}</p>
      </div>
      <form class="footer-subscribe" data-footer-subscribe novalidate>
        <label class="visually-hidden" for="footer-subscribe-email">{t('footer.email_label')}</label>
        <input
          id="footer-subscribe-email"
          class="footer-subscribe-input"
          type="email"
          name="email"
          autocomplete="email"
          required
          placeholder={t('footer.subscribe_placeholder')}
        />
        <button
          class="footer-subscribe-btn"
          type="submit"
          data-label={t('footer.subscribe')}
          data-loading-label={t('footer.subscribe_loading')}
        >
          <span data-footer-subscribe-label>{t('footer.subscribe')}</span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            <path d="M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <p class="footer-subscribe-status" data-footer-subscribe-status role="status" aria-live="polite"></p>
      </form>
    </div>
    <div class="footer-grid">
      <nav class="footer-col" aria-labelledby="footer-company">
        <h2 id="footer-company">{t('footer.company')}</h2>
        <ul>
          {footerCompany.map((link) => (
            <li><a href={link.href}>{t(link.labelKey)}</a></li>
          ))}
        </ul>
      </nav>
      <nav class="footer-col" aria-labelledby="footer-services">
        <h2 id="footer-services">{t('footer.services')}</h2>
        <ul>
          {footerServices.map((link) => (
            <li><a href={link.href}>{t(link.labelKey)}</a></li>
          ))}
        </ul>
      </nav>
      <nav class="footer-col" aria-labelledby="footer-others">
        <h2 id="footer-others">{t('footer.others')}</h2>
        <ul>
          {footerOthers.map((link) => (
            <li><a href={link.href}>{t(link.labelKey)}</a></li>
          ))}
        </ul>
      </nav>
      <nav class="footer-col" aria-labelledby="footer-global">
        <h2 id="footer-global">{t('footer.global')}</h2>
        <ul>
          <li>
            <a href="/software-development-services-in-saudi-arabia">{t('footer.saudi')}</a>
          </li>
        </ul>
      </nav>
    </div>
    <div class="footer-bottom">
      <div class="footer-bottom-copy">
        <p>{t('site.footer.copyright')}</p>
        <div class="legal-links">
          <a href="/privacy-policy">{t('footer.privacy')}</a>
          <span aria-hidden="true">|</span>
          <a href="/terms-and-conditions">{t('footer.terms')}</a>
        </div>
      </div>
      <nav class="footer-social" aria-label={t('footer.social')}>
        <a href={socialLinks[0].href} rel="noopener noreferrer" aria-label={t(socialLinks[0].labelKey)}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4V10c0-.6.4-1 1-1Z"></path>
          </svg>
        </a>
        <a href={socialLinks[1].href} rel="noopener noreferrer" aria-label={t(socialLinks[1].labelKey)}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.5 9H4V20h2.5V9ZM5.2 4C4.2 4 3.4 4.8 3.4 5.8s.8 1.8 1.8 1.8 1.8-.8 1.8-1.8S6.3 4 5.2 4ZM20 20h-2.5v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V20H11V9h2.4v1.5c.3-.6 1.2-1.8 3.1-1.8 3.3 0 3.9 2.2 3.9 5V20Z"></path>
          </svg>
        </a>
        <a href={socialLinks[2].href} rel="noopener noreferrer" aria-label={t(socialLinks[2].labelKey)}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.5"></rect>
            <circle cx="12" cy="12" r="3.75" stroke="currentColor" stroke-width="1.5"></circle>
            <circle cx="17.2" cy="6.8" r="1" fill="currentColor"></circle>
          </svg>
        </a>
      </nav>
    </div>
  </div>
</footer>
<script src="../scripts/footer-subscribe.ts"></script>
