---
import { t } from '../lib/i18n';
import {
  companyLinks,
  serviceGroups,
  serviceSingles,
  servicesOverview,
  solutionLinks,
} from '../lib/nav';

interface Props {
  tone?: 'dark' | 'light';
}

const { tone = 'light' } = Astro.props;
const mobileServiceLinks = [
  servicesOverview,
  ...serviceGroups.flatMap((group) => group.links),
  ...serviceSingles,
];
---
<header class={`site-header tone-${tone}`}>
  <div class="container header-bar">
    <a class="brand" href="/">
      <img src="/logo.png" width="190" height="60" alt={t('site.logo_alt')} />
    </a>
    <nav class="primary-nav" aria-label={t('nav.primary')}>
      <div class="nav-cluster">
        <details class="nav-item">
          <summary>{t('nav.services')}</summary>
          <div class="mega-panel">
            <div>
              <p class="mega-heading">{t('nav.services_intro')}</p>
              <a href={servicesOverview.href}>{t(servicesOverview.labelKey)}</a>
            </div>
            {serviceGroups.map((group) => (
              <div>
                <p class="mega-heading">{t(group.headingKey)}</p>
                <ul>
                  {group.links.map((link) => (
                    <li><a href={link.href}>{t(link.labelKey)}</a></li>
                  ))}
                </ul>
              </div>
            ))}
            <div>
              <ul>
                {serviceSingles.map((link) => (
                  <li><a href={link.href}>{t(link.labelKey)}</a></li>
                ))}
              </ul>
            </div>
          </div>
        </details>
        <details class="nav-item">
          <summary>{t('nav.solutions')}</summary>
          <div class="drop-panel">
            <ul>
              {solutionLinks.map((link) => (
                <li><a href={link.href}>{t(link.labelKey)}</a></li>
              ))}
            </ul>
          </div>
        </details>
        <a class="nav-link" href="/case-studies">{t('nav.case_studies')}</a>
        <details class="nav-item">
          <summary>{t('nav.company')}</summary>
          <div class="drop-panel">
            <ul>
              {companyLinks.map((link) => (
                <li><a href={link.href}>{t(link.labelKey)}</a></li>
              ))}
            </ul>
          </div>
        </details>
      </div>
      <a class="contact-cta" href="/contact-us">{t('nav.contact')}</a>
    </nav>
    <details class="mobile-nav">
      <summary>
        <img src="/icon-menu.svg" width="40" height="40" alt="" />
        <span class="visually-hidden">{t('nav.menu')}</span>
      </summary>
      <div class="mobile-panel">
        <details>
          <summary>{t('nav.services')}</summary>
          <ul>
            {mobileServiceLinks.map((link) => (
              <li><a href={link.href}>{t(link.labelKey)}</a></li>
            ))}
          </ul>
        </details>
        <details>
          <summary>{t('nav.solutions')}</summary>
          <ul>
            {solutionLinks.map((link) => (
              <li><a href={link.href}>{t(link.labelKey)}</a></li>
            ))}
          </ul>
        </details>
        <p><a href="/case-studies">{t('nav.case_studies')}</a></p>
        <details>
          <summary>{t('nav.company')}</summary>
          <ul>
            {companyLinks.map((link) => (
              <li><a href={link.href}>{t(link.labelKey)}</a></li>
            ))}
          </ul>
        </details>
        <p><a class="contact-cta" href="/contact-us">{t('nav.contact')}</a></p>
      </div>
    </details>
  </div>
</header>
