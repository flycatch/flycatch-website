---
import { t } from '../lib/i18n';
import {
  companyMenuColumns,
  mobileApplicationLinks,
  mobileCompanyLinks,
  mobileDevopsLinks,
  mobileServiceLeaves,
  serviceFlyoutApplication,
  serviceFlyoutColumnFour,
  serviceFlyoutDevops,
  servicesOverview,
  socialLinks,
} from '../lib/nav';

interface Props {
  tone?: 'dark' | 'light';
}

const { tone = 'light' } = Astro.props;
---
<header class={`site-header tone-${tone}`} data-tone={tone}>
  <div class="container header-bar">
    <a class="brand" href="/">
      <img class="brand-logo brand-logo-on-dark" src="/flycatch-logo-light.png" width="190" height="60" alt={t('site.logo_alt')} />
      <img class="brand-logo brand-logo-on-light" src="/flycatch-logo-dark.png" width="190" height="60" alt="" />
    </a>
    <nav class="primary-nav" aria-label={t('nav.primary')}>
      <div class="nav-cluster">
        <div class="nav-item has-menu">
          <button
            class="nav-trigger type-nav"
            type="button"
            aria-expanded="false"
            aria-controls="services-flyout"
            aria-haspopup="true"
          >
            {t('nav.services')}
          </button>
          <div class="flyout" id="services-flyout">
            <div class="flyout-panel">
              <div class="container flyout-grid flyout-grid-services">
                <div class="flyout-intro">
                  <p class="flyout-tagline">{t('nav.services_intro')}</p>
                  <a class="btn btn-on-dark" href={servicesOverview.href}>
                    {t(servicesOverview.labelKey)}
                    <svg width="24" height="24" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </a>
                </div>
                <div>
                  <p class="flyout-heading">{t('nav.flyout_application_services')}</p>
                  <ul>
                    {serviceFlyoutApplication.links.map((link) => (
                      <li><a href={link.href}>{t(link.labelKey)}</a></li>
                    ))}
                  </ul>
                </div>
                <div>
                  <p class="flyout-heading">{t('nav.flyout_devops')}</p>
                  <ul>
                    {serviceFlyoutDevops.map((link) => (
                      <li><a href={link.href}>{t(link.labelKey)}</a></li>
                    ))}
                  </ul>
                </div>
                <ul>
                  {serviceFlyoutColumnFour.map((link) => (
                    <li><a href={link.href}>{t(link.labelKey)}</a></li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
        <a class="nav-link type-nav" href="/solutions">{t('nav.solutions')}</a>
        <a class="nav-link type-nav" href="/case-studies">{t('nav.case_studies')}</a>
        <div class="nav-item has-menu">
          <button
            class="nav-trigger type-nav"
            type="button"
            aria-expanded="false"
            aria-controls="company-flyout"
            aria-haspopup="true"
          >
            {t('nav.company')}
          </button>
          <div class="flyout" id="company-flyout">
            <div class="flyout-panel">
            <div class="container flyout-grid flyout-grid-company">
              <p class="flyout-tagline">{t('nav.services_intro')}</p>
              {companyMenuColumns.map((links) => (
                <ul>
                  {links.map((link) => (
                    <li><a href={link.href}>{t(link.labelKey)}</a></li>
                  ))}
                </ul>
              ))}
              <div class="flyout-social-col">
                <nav class="flyout-social" aria-label={t('footer.social')}>
                  <a href={socialLinks[0].href} rel="noopener noreferrer" aria-label={t(socialLinks[0].labelKey)}>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4V10c0-.6.4-1 1-1Z"></path>
                    </svg>
                  </a>
                  <a href={socialLinks[1].href} rel="noopener noreferrer" aria-label={t(socialLinks[1].labelKey)}>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M6.5 9H4V20h2.5V9ZM5.2 4C4.2 4 3.4 4.8 3.4 5.8s.8 1.8 1.8 1.8 1.8-.8 1.8-1.8S6.3 4 5.2 4ZM20 20h-2.5v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V20H11V9h2.4v1.5c.3-.6 1.2-1.8 3.1-1.8 3.3 0 3.9 2.2 3.9 5V20Z"></path>
                    </svg>
                  </a>
                  <a href={socialLinks[2].href} rel="noopener noreferrer" aria-label={t(socialLinks[2].labelKey)}>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.5"></rect>
                      <circle cx="12" cy="12" r="3.75" stroke="currentColor" stroke-width="1.5"></circle>
                      <circle cx="17.2" cy="6.8" r="1" fill="currentColor"></circle>
                    </svg>
                  </a>
                </nav>
                <p class="type-meta flyout-copy">{t('nav.copyright')}</p>
              </div>
            </div>
            </div>
          </div>
        </div>
      </div>
      <a class="contact-cta" href="/contact-us">{t('nav.contact')}</a>
    </nav>
    <button
      class="mobile-nav-toggle"
      type="button"
      data-mobile-toggle
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <path
          d="M6.66667 30H33.3333C34.25 30 35 29.25 35 28.3333C35 27.4167 34.25 26.6667 33.3333 26.6667H6.66667C5.75 26.6667 5 27.4167 5 28.3333C5 29.25 5.75 30 6.66667 30ZM6.66667 21.6667H33.3333C34.25 21.6667 35 20.9167 35 20C35 19.0833 34.25 18.3333 33.3333 18.3333H6.66667C5.75 18.3333 5 19.0833 5 20C5 20.9167 5.75 21.6667 6.66667 21.6667ZM5 11.6667C5 12.5833 5.75 13.3333 6.66667 13.3333H33.3333C34.25 13.3333 35 12.5833 35 11.6667C35 10.75 34.25 10 33.3333 10H6.66667C5.75 10 5 10.75 5 11.6667Z"
          fill="currentColor"
        ></path>
      </svg>
      <span class="visually-hidden">{t('nav.menu')}</span>
    </button>
  </div>
</header>
<div class="mobile-drawer" id="mobile-drawer" data-mobile-drawer hidden>
  <div class="mobile-drawer-overlay" data-mobile-close tabindex="-1"></div>
  <div
    class="mobile-drawer-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mobile-drawer-title"
    data-mobile-panel
  >
    <div class="mobile-drawer-toolbar">
      <button class="mobile-drawer-back" type="button" data-mobile-back hidden>
        <img src="/icon-menu-back.svg" width="6" height="11" alt="" aria-hidden="true" />
        {t('nav.back')}
      </button>
      <button class="mobile-drawer-close" type="button" data-mobile-close>
        <img src="/icon-menu-close.svg" width="40" height="40" alt="" aria-hidden="true" />
        <span class="visually-hidden">{t('nav.menu_close')}</span>
      </button>
    </div>
    <div class="mobile-drawer-frames" data-mobile-frames>
      <div class="mobile-drawer-view is-active" data-panel="root">
        <h2 class="visually-hidden" id="mobile-drawer-title">{t('nav.menu')}</h2>
        <ul class="mobile-drawer-list">
          <li>
            <button
              class="mobile-drawer-item"
              type="button"
              data-mobile-push="services"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="mobile-panel-services"
            >
              <span>{t('nav.services')}</span>
              <img src="/icon-menu-next.svg" width="26" height="27" alt="" aria-hidden="true" />
            </button>
          </li>
          <li>
            <a class="mobile-drawer-item" href="/solutions">{t('nav.solutions')}</a>
          </li>
          <li>
            <a class="mobile-drawer-item" href="/case-studies">{t('nav.mobile_case_studies')}</a>
          </li>
          <li>
            <button
              class="mobile-drawer-item"
              type="button"
              data-mobile-push="company"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="mobile-panel-company"
            >
              <span>{t('nav.company')}</span>
              <img src="/icon-menu-next.svg" width="26" height="27" alt="" aria-hidden="true" />
            </button>
          </li>
          <li>
            <a class="mobile-drawer-item" href="/company/blogs">{t('nav.resources')}</a>
          </li>
          <li>
            <a class="mobile-drawer-item" href="/company/clients">{t('nav.clients')}</a>
          </li>
          <li>
            <a class="mobile-drawer-item" href="/company/testimonials">{t('nav.testimonials')}</a>
          </li>
          <li>
            <a class="mobile-drawer-cta contact-cta" href="/contact-us">{t('nav.contact_us')}</a>
          </li>
        </ul>
      </div>
      <div class="mobile-drawer-view" id="mobile-panel-services" data-panel="services" inert>
        <h2 class="mobile-drawer-heading">{t('nav.services')}</h2>
        <ul class="mobile-drawer-list">
          <li>
            <a class="mobile-drawer-item" href={servicesOverview.href}>{t(servicesOverview.labelKey)}</a>
          </li>
          <li>
            <button
              class="mobile-drawer-item"
              type="button"
              data-mobile-push="application"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="mobile-panel-application"
            >
              <span>{t('nav.flyout_application_services')}</span>
              <img src="/icon-menu-next.svg" width="26" height="27" alt="" aria-hidden="true" />
            </button>
          </li>
          <li>
            <button
              class="mobile-drawer-item"
              type="button"
              data-mobile-push="devops"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="mobile-panel-devops"
            >
              <span>{t('nav.flyout_devops')}</span>
              <img src="/icon-menu-next.svg" width="26" height="27" alt="" aria-hidden="true" />
            </button>
          </li>
          {mobileServiceLeaves.map((link) => (
            <li>
              <a class="mobile-drawer-item" href={link.href}>{t(link.labelKey)}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="mobile-drawer-view" id="mobile-panel-application" data-panel="application" inert>
        <h2 class="mobile-drawer-heading">{t('nav.flyout_application_services')}</h2>
        <ul class="mobile-drawer-list">
          {mobileApplicationLinks.map((link) => (
            <li>
              <a class="mobile-drawer-item" href={link.href}>{t(link.labelKey)}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="mobile-drawer-view" id="mobile-panel-devops" data-panel="devops" inert>
        <h2 class="mobile-drawer-heading">{t('nav.flyout_devops')}</h2>
        <ul class="mobile-drawer-list">
          {mobileDevopsLinks.map((link) => (
            <li>
              <a class="mobile-drawer-item" href={link.href}>{t(link.labelKey)}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="mobile-drawer-view" id="mobile-panel-company" data-panel="company" inert>
        <h2 class="mobile-drawer-heading">{t('nav.company')}</h2>
        <ul class="mobile-drawer-list">
          {mobileCompanyLinks.map((link) => (
            <li>
              <a class="mobile-drawer-item" href={link.href}>{t(link.labelKey)}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</div>
{tone === 'light' && <div class="header-spacer" aria-hidden="true"></div>}
<script src="../scripts/site-header.ts"></script>
