---
import OptimizedImage from './OptimizedImage.astro';
import { t } from '../lib/i18n';

const title = t('page.ai_services.minds_title');
const body = t('page.ai_services.minds_body');
const stats = [
  { valueKey: 'home.minds_stat.years.value', labelKey: 'home.minds_stat.years.label' },
  { valueKey: 'home.minds_stat.projects.value', labelKey: 'home.minds_stat.projects.label' },
  { valueKey: 'home.minds_stat.customers.value', labelKey: 'home.minds_stat.customers.label' },
  { valueKey: 'home.minds_stat.associates.value', labelKey: 'home.minds_stat.associates.label' },
].map((stat) => {
  const raw = t(stat.valueKey);
  const match = raw.match(/^(.*?)(\+)$/);
  return {
    ...stat,
    number: match ? match[1] : raw,
    plus: match ? match[2] : '',
    label: t(stat.labelKey),
  };
});
---
<section class="ai-minds" id="great-minds" aria-labelledby="ai-minds-heading" data-ai-minds>
  <div class="ai-minds-media" aria-hidden="true">
    <OptimizedImage
      class="ai-minds-globe"
      src="/ai-services/minds-globe.png"
      alt=""
      width={1512}
      height={672}
      sizes="100vw"
    />
    <span class="ai-minds-hue"></span>
  </div>
  <div class="container ai-minds-inner">
    <h2 id="ai-minds-heading">{title}</h2>
    <p class="ai-minds-copy">{body}</p>
    <ul class="ai-minds-stats">
      {stats.map((stat) => (
        <li class="ai-minds-stat">
          <span class="ai-minds-stat-value">
            <span class="ai-minds-stat-number" data-stat-target={stat.number}>{stat.number}</span>
            {stat.plus && <span class="ai-minds-stat-plus">{stat.plus}</span>}
          </span>
          <span class="ai-minds-stat-label">{stat.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script src="../scripts/ai-minds.ts"></script>
