---
import { aiChatSupportCopy as copy } from '../lib/ai-chat-support-data';
---
<section class="acs-features" aria-labelledby="acs-features-heading">
  <div class="container acs-features-inner">
    <div class="acs-features-aside">
      <h2 id="acs-features-heading" class="acs-display" data-acs-reveal>{copy.features.heading}</h2>
      <p class="acs-feature-intro" data-acs-reveal>{copy.features.intro}</p>
      <img
        class="acs-features-visual"
        src="/ai-chat-support/key-features.webp"
        alt={copy.features.imageAlt}
        width="480"
        height="510"
        loading="lazy"
        data-acs-reveal
      />
    </div>
    <ul class="acs-feature-list">
      {copy.features.items.map((item) => (
        <li class="acs-feature" data-acs-reveal>
          <img
            class="acs-feature-icon"
            src={item.icon}
            alt=""
            width="70"
            height="70"
          />
          <div class="acs-feature-text">
            <h3 class="acs-feature-title">{item.title}</h3>
            <p class="acs-feature-body">{item.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
