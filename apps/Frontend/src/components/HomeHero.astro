---
import { t } from '../lib/i18n';
import { publicMediaUrl } from '../lib/public-api';

interface Props {
  home: {
    video_key: string | null;
    banner_title: string;
    title?: string;
    seo: {
      h1_tag?: string;
      image_alt?: string;
    };
  };
  exploreLabel?: string;
}

const { home, exploreLabel = '' } = Astro.props;
const video = publicMediaUrl(home.video_key);
const heading = home.banner_title.trim() || home.seo.h1_tag?.trim() || home.title || '';
const explore = exploreLabel.trim() || t('home.explore');
---
<section class="hero" aria-labelledby="home-heading">{video ? (
    <video
      class="hero-media"
      src={video}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    />
  ) : (
    <div class="hero-fallback" role="img" aria-label={home.seo.image_alt || t('home.hero_unavailable')}></div>
  )}
  <div class="hero-scrim"></div>
  <div class="container hero-copy summary-region" data-hero-copy>
    <div class="hero-heading">
      <h1 id="home-heading" class="type-hero" data-hero-entrance>{heading}</h1>
    </div>
    <a class="explore" href="#services">
      <img src="/icon-explore.svg" width="104" height="104" alt="" />
      <span>{explore}</span>
    </a>
  </div>
</section>
<script src="../scripts/home-hero.ts"></script>
