---
import { t } from '../lib/i18n';

const stats = [
  { number: '5', plus: '', label: 'Years in IT industry' },
  { number: '55', plus: '+', label: 'Projects' },
  { number: '30', plus: '+', label: 'Customers' },
  { number: '60', plus: '+', label: 'Associates' },
];
---
<section class="section section-dark about-minds" id="great-minds" aria-labelledby="about-minds-heading">
  <div class="container minds-layout">
    <figure class="minds-orbit" data-minds-stats>
      <img
        class="minds-orbit-image"
        src="/company/about-us/aboutUsOrbit.webp"
        alt={t('home.minds_image_alt')}
        width="640"
        height="632"
        loading="lazy"
      />
      <img
        class="minds-stats-glow"
        src="/about-us-stats-glow.png"
        alt=""
        width="500"
        height="500"
        loading="lazy"
      />
      <ul class="minds-stats" aria-live="polite">
        {stats.map((stat, index) => (
          <li
            class:list={['minds-stat', { 'is-active': index === 0 }]}
            data-stat-index={index}
            aria-hidden={index === 0 ? 'false' : 'true'}
          >
            <span class="minds-stat-value">
              <span class="minds-stat-number" data-stat-target={stat.number}>{stat.number}</span>
              {stat.plus && <span class="minds-stat-plus">{stat.plus}</span>}
            </span>
            <span class="minds-stat-label">{stat.label}</span>
          </li>
        ))}
      </ul>
    </figure>
    <div class="minds-copy">
      <h2 id="about-minds-heading" class="type-section">We work with great minds</h2>
      <p class="lede type-lede">
        We are privileged to work with exceptional minds. Our team comprises vetted candidates exuding positivity, fuelled by challenges, and inspired by a nurturing work culture. Their enthusiasm and dedication drive our success as we work together to innovate and excel.
        <span class="minds-join">Join us in shaping the future of IT with passion and purpose.</span>
      </p>
      <p class="minds-actions">
        <a class="btn btn-on-dark" href="/company/about-us">
          About Us
          <img src="/icon-arrow-right.svg" width="24" height="24" alt="" />
        </a>
      </p>
    </div>
  </div>
</section>
<script src="../scripts/home-minds.ts"></script>
