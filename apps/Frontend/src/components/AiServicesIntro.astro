---
import type { PublicAiService } from '../lib/public-api';

interface Props {
  page: PublicAiService;
}

const { page } = Astro.props;
const title = page.introduction_title.trim();
const description = page.introduction_description.trim();
const show = Boolean(title || description);
---
{show && (
  <section class="ai-intro" aria-labelledby="ai-intro-heading">
    <div class="container">
      <div class="ai-intro-inner">
        <h2 id="ai-intro-heading" class="type-display" hidden={!title}>{title}</h2>
        <p class="ai-copy" hidden={!description}>{description}</p>
      </div>
    </div>
  </section>
)}
