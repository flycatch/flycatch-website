---
import { publicMediaUrl } from '../lib/public-api';
import type { PublicOfferingsLanding } from '../lib/public-api';
import SectionState from './SectionState.astro';
import { t } from '../lib/i18n';

interface Props {
  page?: PublicOfferingsLanding | null;
  failed?: boolean;
  fallbackTitle?: string;
}

const { page = null, failed = false, fallbackTitle = t('page.application_development.title') } =
  Astro.props;
const banner = page ? publicMediaUrl(page.banner_image_key) : null;
const heading = page?.banner_title.trim() || fallbackTitle;
---
<section class="ads-hero" aria-labelledby="ads-heading">
  {banner ? (
    <img
      class="ads-hero-media"
      src={banner}
      alt={page?.seo.image_alt || page?.banner_title}
      width="1512"
      height="982"
    />
  ) : (
    <div class="ads-hero-media ads-hero-fallback"></div>
  )}
  <div class="ads-hero-overlay" aria-hidden="true"></div>
  <div class="container ads-hero-copy">
    <h1 id="ads-heading" class="type-hero">{heading}</h1>
    {!page && <SectionState error={failed} empty={!failed} />}
  </div>
</section>
<script src="../scripts/ads-hero.ts"></script>
