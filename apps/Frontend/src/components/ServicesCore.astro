---
import { t } from '../lib/i18n';

const items = [
  {
    title: t('page.services.core.digital.title'),
    body: t('page.services.core.digital.body'),
    image: '/services/digitalTransformationBanner.webp',
    alt: t('page.services.core.digital.image_alt'),
    href: '/services/digital-transformation',
    imageFirst: true,
  },
  {
    title: t('page.services.core.application.title'),
    body: t('page.services.core.application.body'),
    image: '/services/applicationServicesImage.webp',
    alt: t('page.services.core.application.image_alt'),
    href: '/services/application-development-services',
    imageFirst: false,
  },
  {
    title: t('page.services.core.devops.title'),
    body: t('page.services.core.devops.body'),
    image: '/services/devopsServiceImage.webp',
    alt: t('page.services.core.devops.image_alt'),
    href: '/services/devOps-consultation',
    imageFirst: true,
  },
  {
    title: t('page.services.core.cloud.title'),
    body: t('page.services.core.cloud.body'),
    image: '/services/cloudServiceImage.webp',
    alt: t('page.services.core.cloud.image_alt'),
    href: '/services/cloud-migration',
    imageFirst: false,
  },
  {
    title: t('page.services.core.data.title'),
    body: t('page.services.core.data.body'),
    image: '/services/analyticServiceImage.webp',
    alt: t('page.services.core.data.image_alt'),
    href: '/services/data-migration',
    imageFirst: true,
  },
];
---
<noscript>
  <style>
    .services-core-row {
      opacity: 1;
      transform: none;
    }
  </style>
</noscript>
<section class="services-core" aria-labelledby="services-core-heading">
  <div class="container">
    <h2 id="services-core-heading">{t('page.services.core_title')}</h2>
    <ul class="services-core-list">
      {items.map((item) => (
        <li class:list={['services-core-row', { 'is-image-first': item.imageFirst }]} data-services-core-row>
          <div class="services-core-media">
            <img src={item.image} alt={item.alt} width="720" height="350" loading="lazy" />
          </div>
          <div class="services-core-copy">
            <div class="services-core-text">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
            <p class="services-core-actions">
              <a class="btn" href={item.href}>
                {t('page.services.explore_more')}
                <img src="/icon-arrow-right.svg" width="24" height="24" alt="" />
              </a>
            </p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
<script src="../scripts/services-core.ts"></script>
