# Shared gateway routing for Docker Compose and k8s.
# Compose mounts this path; k8s generates a ConfigMap from it.
# Path-based gateway — single origin for Frontend, Administration FE, and Backend

(base_security) {
	header {
		# defer so these win over headers copied from upstream (e.g. Backend)
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
	}
}

# Keep the visitor Host so Astro origin checks and absolute URLs
# match the gateway, not frontend:4321.
(frontend_upstream) {
	reverse_proxy frontend:4321 {
		header_up Host {http.request.hostport}
	}
}

:{$GATEWAY_PORT:8080} {
	import base_security

	@apex host flycatchtech.com
	redir @apex https://www.flycatchtech.com{uri} 301

	@insecure_canonical {
		protocol http
		host www.flycatchtech.com flycatchtech.com
	}
	redir @insecure_canonical https://www.flycatchtech.com{uri} 301

	@trailing_slash {
		path_regexp slash ^(.+)/$
		not path /admin/
	}
	redir @trailing_slash {re.slash.1} 301

	redir /services/hybrid-cloud /services/cloud-migration 301
	redir /services/cloud-security /services/cloud-migration 301
	redir /services/cloud-optimization /services/cloud-migration 301
	redir /services/data-management-strategy /services/data-migration 301
	redir /services/data-engineering /services/data-migration 301
	redir /services/devops-consultation /services/devOps-consultation 301
	redir /solutions/flygrid-ai /solutions/flyGrid-ai 301
	redir /solutions/doctcare-ai /solutions/doctCare-ai 301
	redir /solutions/talkshop-ai /solutions/talkShop-ai 301
	redir /solutions/docsis-ai /solutions/docSis-ai 301
	redir /company / 301
	redir /en / 301
	@legacy_locale path_regexp locale ^/en/(.*)$
	redir @legacy_locale /{re.locale.1} 301

	# Keep /admin on the Administration FE (never the public site)
	redir /admin /admin/ 308

	# Fingerprinted frontend assets
	handle /_astro/* {
		header Cache-Control "public, max-age=31536000, immutable"
		import frontend_upstream
	}

	# CMS media — address changes when the asset is replaced
	handle /api/v1/public/media/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy backend:8000
	}

	# Public form posts stay on the site, then the Frontend proxies to the CMS
	handle /api/forms* {
		header Cache-Control "no-store"
		import frontend_upstream
	}

	# Backend API
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Administration FE — astro preview serves built assets at /_astro, not /admin/_astro
	handle /admin/_astro/* {
		uri strip_prefix /admin
		header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:"
		reverse_proxy administration-fe:4173
	}

	# Public files from Administration FE live at dist root (not under /admin/)
	@admin_public_icons {
		path /admin/favicon.ico /admin/favicon.png /admin/apple-touch-icon.png
	}
	handle @admin_public_icons {
		uri strip_prefix /admin
		header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:"
		reverse_proxy administration-fe:4173
	}

	# Administration FE
	handle /admin* {
		header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:"
		reverse_proxy administration-fe:4173
	}

	# Public Frontend (SSR). Astro inlines small page scripts (header, home
	# interactions) and JSON-LD as <script type="module"> / application/ld+json,
	# so script-src needs 'unsafe-inline' (same as /admin*). Styles may be
	# inlined or served from /_astro/*.css.
	handle {
		header Cache-Control "public, max-age=60, stale-while-revalidate=600"
		header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; media-src 'self'; connect-src 'self' https://www.google.com https://www.googletagmanager.com https://www.google-analytics.com; frame-src https://www.google.com"
		import frontend_upstream
	}
}
