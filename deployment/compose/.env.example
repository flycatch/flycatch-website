# Shared deployment configuration — copy to .env and adjust

# Gateway (single origin)
PUBLIC_ORIGIN=http://localhost:8080
GATEWAY_PORT=8080

# Environment: development | production
# Non-production disables SEO indexing (robots.txt Disallow, noindex meta, X-Robots-Tag).
PUBLIC_ENVIRONMENT=development
ENVIRONMENT=development

# PostgreSQL
POSTGRES_DB=flycatch
POSTGRES_USER=flycatch
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://flycatch:change-me@postgres:5432/flycatch

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_BUCKET=flycatch
S3_REGION=us-east-1
S3_USE_SSL=false

# Backend
BACKEND_PORT=8000
SESSION_SECRET=change-me-long-random
CSRF_SECRET=change-me-long-random
JWT_SECRET=change-me-long-random-jwt
JWT_ACCESS_MINUTES=15
BUILD_EXPORT_TOKEN=change-me-for-snapshot-export

# Frontend image build prerenders from this origin (host gateway after import).
# Runtime still uses API_ORIGIN=http://backend:8000 inside Compose.
FRONTEND_BUILD_API_ORIGIN=http://host.docker.internal:8080

# Frontend / Administration FE (build-time and runtime public URLs)
# Administration FE calls Backend through the gateway at PUBLIC_ORIGIN/api/v1
